---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';

/* ==========================================================================
   Exported primitives.

   These live in the layout because it is the only module every page template
   already imports, which makes it the single place canonical URLs, SERP length
   budgets and description clamping are defined. Templates import them from
   here instead of re-deriving the same rules in eight files.
   ========================================================================== */

export const SITE_URL = 'https://allcutoff.com';
export const BRAND_NAME = 'All Cut Off';
export const BRAND_SUFFIX = ` | ${BRAND_NAME}`;

/** SERP budgets, in characters. Titles truncate around 60, snippets at ~158. */
export const TITLE_MAX = 60;
export const DESCRIPTION_MAX = 158;
export const DESCRIPTION_MIN = 120;

/**
 * The site-level description. It describes the SITE, so it must never be
 * overwritten by a page prop: 30 pages each shipping their own `WebSite`
 * description is how you end up with 30 self-contradicting site definitions.
 */
export const SITE_DESCRIPTION =
  'Free Indian college admission cutoff calculators for TNEA, KCET, NEET UG, AP & TS EAPCET, MHT CET, KEAM, GUJCET, DU CSAS, TNAU, TNGASA, TANUVAS and paramedical courses. Official published formulas, instant results.';

export const CANONICAL_HOST = 'allcutoff.com';

/**
 * Collapse any URL — absolute, relative, protocol-relative or the site's own
 * `/?calc=<id>` deep link — into the one canonical form this site ships:
 * `https://allcutoff.com` + a clean, slash-free, query-free, fragment-free path.
 *
 * Query strings and fragments are dropped on purpose: the hero calculator writes
 * `?calc=<id>` into the address bar, so every deep-linked variant of one page
 * would otherwise advertise itself as a separate canonical.
 */
export const normalizeUrl = (url: string): string => {
  let parsed: URL;
  try {
    parsed = new URL(url, `${SITE_URL}/`);
  } catch {
    return `${SITE_URL}/`;
  }

  parsed.protocol = 'https:';
  parsed.host = CANONICAL_HOST;
  parsed.search = '';
  parsed.hash = '';

  const path = parsed.pathname.replace(/\/{2,}/g, '/').replace(/\/+$/, '');
  return `${parsed.origin}${path || '/'}`;
};

/** Escape a value for use inside a double-quoted HTML attribute. */
export const escapeAttr = (value: string): string =>
  String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');

/**
 * Fit a description to the SERP snippet window.
 *
 * The clamp runs on the ESCAPED string, because `&` is one character of source
 * but five in the rendered attribute — clamping before escaping under-reports
 * the length and overflows the snippet. Truncation only ever happens on a word
 * boundary and never appends an ellipsis: an ellipsised description reads as
 * broken and costs clicks, so the templates are written short enough that this
 * cut path is a safety net rather than a routine.
 */
export const clampDescription = (value: string, max = DESCRIPTION_MAX): string => {
  const escaped = escapeAttr(value);
  if (escaped.length <= max) return escaped;

  const cut = escaped.slice(0, max);
  const boundary = cut.lastIndexOf(' ');
  let out = (boundary > max * 0.6 ? cut.slice(0, boundary) : cut).replace(/[\s,;:.\-&]+$/, '');

  // A hard cut can land inside an entity we just introduced (`&am`). Roll it back
  // to the last complete token so the attribute is never malformed.
  const amp = out.lastIndexOf('&');
  if (amp !== -1 && !out.slice(amp).includes(';')) out = out.slice(0, amp);

  return out;
};

/**
 * Choose a meta description from a ladder of wordings ordered richest-first.
 * The first candidate inside the snippet window wins; otherwise the longest
 * candidate that still fits. Measuring beats hand-tuning: the same category
 * template lands at 137 characters for a one-item section and 152 for a
 * four-item one, and both read as complete sentences.
 */
export const pickDescription = (
  candidates: string[],
  min = DESCRIPTION_MIN,
  max = DESCRIPTION_MAX
): string => {
  const inWindow = candidates.find((c) => c.length >= min && c.length <= max);
  if (inWindow) return inWindow;

  const fits = candidates.filter((c) => c.length <= max).sort((a, b) => b.length - a.length);
  return fits[0] ?? candidates[0] ?? '';
};

interface Props {
  title: string;
  description?: string;
  currentCategory?: string;
  /** Absolute URL of this page; the single source of truth for `rel=canonical`. */
  canonicalUrl?: string;
  /** Real content-review date for THIS page (YYYY-MM-DD). Never the build clock. */
  dateModified?: string;
  extraSchema?: unknown | unknown[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  currentCategory = '',
  canonicalUrl,
  dateModified,
  extraSchema
} = Astro.props;

const siteUrl = SITE_URL;
const brandName = BRAND_NAME;

const canonical = normalizeUrl(canonicalUrl ?? Astro.url.href);

const fullTitle = title.endsWith(brandName) ? title : `${title}${BRAND_SUFFIX}`;

/* Social platforms reject SVG for og:image, so the PNG is the canonical asset.
   /og-image.svg is kept in public/ purely as the vector source. */
const ogImage = `${siteUrl}/og-image.png`;
const ogImageWidth = 1200;
const ogImageHeight = 630;
const ogImageAlt = `${brandName} - verified admission cutoff calculators for India`;

const organizationId = `${siteUrl}/#organization`;
const websiteId = `${siteUrl}/#website`;
const pageId = `${canonical}#webpage`;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': websiteId,
    name: brandName,
    url: siteUrl,
    description: SITE_DESCRIPTION,
    inLanguage: 'en-IN',
    publisher: { '@id': organizationId }
  },
  {
    '@type': 'Organization',
    '@id': organizationId,
    name: brandName,
    url: siteUrl,
    logo: `${siteUrl}/icon-512.png`
  }
];

/* `WebApplication` describes the tool itself, which only exists on the home
   page. Emitting it everywhere claimed that /privacy and /disclaimer were
   software applications, and duplicated the per-page `SoftwareApplication` that
   every calculator page already declares. */
const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '';

if (isHomepage) {
  graph.push({
    '@type': 'WebApplication',
    '@id': `${websiteId}-app`,
    name: brandName,
    url: siteUrl,
    description: SITE_DESCRIPTION,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires JavaScript',
    isAccessibleForFree: true,
    featureList: [
      'Instant client-side cutoff calculation',
      'Official formula transparency',
      'No sign-up required'
    ],
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'INR'
    },
    publisher: { '@id': organizationId }
  });
}

if (extraSchema) {
  const extras = Array.isArray(extraSchema) ? extraSchema : [extraSchema];
  for (const entry of extras) {
    if (!entry || typeof entry !== 'object') continue;
    const node = entry as Record<string, unknown>;
    const id = typeof node['@id'] === 'string' ? node['@id'] : undefined;
    const existing = id ? graph.findIndex((n) => n['@id'] === id) : -1;
    // Merge into an existing node rather than emitting a second one: schema.org
    // requires @id to be unique within a graph, and a duplicate silently voids
    // the whole structured-data set.
    if (existing !== -1) graph[existing] = { ...graph[existing], ...node };
    else if (node['@type']) graph.push(node);
  }
}

/* Templates that build a richer page node (WebPage / CollectionPage) own it
   themselves. Everything else — the four utility pages and the home page — gets
   one here so no route ships a visible page with no page-level entity. */
const PAGE_NODE_TYPES = new Set(['WebPage', 'CollectionPage', 'ItemPage']);
const hasOwnPageNode = graph.some((node) => {
  const type = node['@type'];
  return typeof type === 'string' && PAGE_NODE_TYPES.has(type);
});

if (!hasOwnPageNode) {
  const breadcrumb = graph.find((node) => node['@type'] === 'BreadcrumbList');
  graph.push({
    '@type': 'WebPage',
    '@id': pageId,
    url: canonical,
    name: fullTitle,
    description,
    inLanguage: 'en-IN',
    isPartOf: { '@id': websiteId },
    ...(breadcrumb ? { breadcrumb: { '@id': breadcrumb['@id'] } } : {}),
    ...(dateModified ? { dateModified } : {})
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph
};
---

<!doctype html>
<html lang="en-IN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Icons & App Metadata. The PNGs are real, already-built assets, so they
         are declared as sized fallbacks rather than shipping a URL that 404s.
         `mask-icon` is deliberately absent: it requires a MONOCHROME svg and
         /favicon.svg is full-colour, so Safari was rendering nothing. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="AllCutOff" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Primary SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={brandName} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#2563eb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f172a" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Font Preconnections -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <!-- `100vh` is the LARGE viewport on iOS/Android, so the page rubber-bands on
       every scroll. `min-h-dvh` is emitted BEFORE `min-h-screen` in Tailwind v4's
       utility order, so the two in one class list would silently leave `vh`
       winning; gating `dvh` behind `@supports` is what actually makes the
       fallback work (same pattern SearchModal uses for its own dvh cap). -->
  <body class="flex min-h-screen supports-[height:100dvh]:min-h-dvh flex-col bg-slate-50 text-slate-700 antialiased">
    <Header currentCategory={currentCategory} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <SearchModal />
  </body>
</html>

<!--
  Service-worker registration. Deliberately a processed <script> (NOT is:inline) so
  that Vite can statically replace `import.meta.env.PROD`; left inline it would be
  a live property read that throws in the browser. Astro bundles it once and emits
  it as a deferred module, so it runs on every page without blocking render.
-->
<script>
  (function () {
    'use strict';

    try {
      if (!('serviceWorker' in navigator) || !import.meta.env.PROD) return;

      var RELOAD_FLAG = '_sw-reloaded';
      var TOAST_MS = 8000;

      /* A first-install clients.claim() also fires controllerchange; only a real
         swap of an already-controlling worker should reload the page. */
      var hadController = !!navigator.serviceWorker.controller;
      var reloaded = false;

      function alreadyReloaded() {
        try {
          return window.sessionStorage.getItem(RELOAD_FLAG) === '1';
        } catch (e) {
          return false;
        }
      }

      function markReloaded() {
        try {
          window.sessionStorage.setItem(RELOAD_FLAG, '1');
        } catch (e) {
          /* private mode — the in-memory guard still prevents a loop */
        }
      }

      function showToast(message) {
        if (!message || !document.body) return;

        var bar = document.createElement('div');
        bar.className = 'no-print';
        bar.setAttribute('role', 'status');
        bar.setAttribute('aria-live', 'polite');
        bar.setAttribute('data-sw-toast', '');
        bar.style.cssText = [
          'position:fixed',
          'left:50%',
          'bottom:16px',
          'transform:translateX(-50%)',
          'z-index:9999',
          'display:flex',
          'align-items:center',
          'gap:12px',
          'max-width:calc(100vw - 32px)',
          'padding:8px 8px 8px 16px',
          'border-radius:12px',
          'border:1px solid #e2e8f0',
          'background:#ffffff',
          'color:#334155',
          'box-shadow:0 12px 32px -14px rgba(15,23,42,.45)',
          'font-size:.875rem',
          'line-height:1.4',
          'pointer-events:auto'
        ].join(';');

        var text = document.createElement('span');
        text.style.cssText = 'flex:1 1 auto;min-width:0;';
        text.textContent = message;

        function dismiss() {
          if (bar.parentNode) bar.parentNode.removeChild(bar);
        }

        var close = document.createElement('button');
        close.type = 'button';
        close.setAttribute('aria-label', 'Dismiss notification');
        close.textContent = '\u00d7';
        close.style.cssText = [
          'flex:none',
          'width:32px',
          'height:32px',
          'padding:0',
          'border:0',
          'border-radius:8px',
          'background:#f1f5f9',
          'color:#64748b',
          'font-size:20px',
          'line-height:1',
          'cursor:pointer'
        ].join(';');

        close.addEventListener('click', dismiss);
        bar.appendChild(text);
        bar.appendChild(close);
        document.body.appendChild(bar);
        window.setTimeout(dismiss, TOAST_MS);
      }

      function watch(reg) {
        if (!reg) return;
        if (reg.waiting) {
          showToast('All Cut Off has been updated. Reloading\u2026');
          reg.waiting.postMessage({ type: 'SKIP_WAITING' });
        }
        reg.addEventListener('updatefound', function () {
          var installing = reg.installing;
          if (!installing) return;
          installing.addEventListener('statechange', function () {
            /* `controller` existing means this is an update, not a first install. */
            if (installing.state === 'installed' && navigator.serviceWorker.controller) {
              showToast('A new version of All Cut Off is ready. Reloading\u2026');
            }
          });
        });
      }

      function register() {
        navigator.serviceWorker
          .register('/sw.js', { scope: '/' })
          .then(watch)
          .catch(function () {
            /* Unsupported, insecure origin, or blocked — offline just stays off. */
          });
      }

      navigator.serviceWorker.addEventListener('message', function (event) {
        var data = event.data;
        if (!data || typeof data !== 'object') return;
        if (data.type === 'SW_ACTIVATED' && hadController) {
          showToast('All Cut Off was updated. Reloading\u2026');
        }
      });

      navigator.serviceWorker.addEventListener('controllerchange', function () {
        if (!hadController) return; // first install: claim() is not an update
        if (reloaded || alreadyReloaded()) return;
        reloaded = true;
        markReloaded();
        window.location.reload();
      });

      function start() {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(register, { timeout: 3000 });
        } else {
          register();
        }
      }

      if (document.readyState === 'complete') start();
      else window.addEventListener('load', start, { once: true });
    } catch (e) {
      /* Service workers are strictly progressive enhancement. */
    }
  })();
</script>