---
/**
 * Global Top Navigation Progress Bar
 * Runs synchronously in parallel with page navigation and rendering with zero delay.
 */
---
<div id="page-progress-bar" class="progress-bar-container" aria-hidden="true">
  <div class="progress-bar-fill"></div>
</div>

<style>
  .progress-bar-container {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 3px;
    z-index: 100000;
    pointer-events: none;
    user-select: none;
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .progress-bar-container.is-active {
    opacity: 1;
  }

  .progress-bar-fill {
    width: 100%;
    height: 100%;
    background-color: #2563eb;
    box-shadow: none;
    transform-origin: 0% 50%;
    transform: scaleX(0);
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .progress-bar-container,
    .progress-bar-fill {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    'use strict';

    var container = document.getElementById('page-progress-bar');
    if (!container) return;
    var fill = container.querySelector('.progress-bar-fill');
    if (!fill) return;

    var NAV_KEY = '_allcutoff_nav';
    var hideTimeout = null;

    function reset() {
      if (hideTimeout) clearTimeout(hideTimeout);
      container.classList.remove('is-active');
      fill.style.transition = 'none';
      fill.style.transform = 'scaleX(0)';
    }

    // Check if this page load came from an internal click navigation
    var wasNavigating = false;
    try {
      if (sessionStorage.getItem(NAV_KEY) === '1') {
        wasNavigating = true;
        sessionStorage.removeItem(NAV_KEY);
      }
    } catch (e) {}

    // Run in parallel with initial render
    if (wasNavigating) {
      // Pick up from the click navigation at 75% and zip to 100% instantly
      container.classList.add('is-active');
      fill.style.transition = 'none';
      fill.style.transform = 'scaleX(0.75)';
      void fill.offsetWidth; // Force instant layout sync

      fill.style.transition = 'transform 120ms cubic-bezier(0.1, 0.8, 0.2, 1)';
      fill.style.transform = 'scaleX(1)';

      hideTimeout = setTimeout(function () {
        container.classList.remove('is-active');
        setTimeout(function () {
          fill.style.transition = 'none';
          fill.style.transform = 'scaleX(0)';
        }, 120);
      }, 140);
    } else {
      // Normal refresh / direct page entry: fast parallel sweep across top (160ms)
      container.classList.add('is-active');
      fill.style.transition = 'none';
      fill.style.transform = 'scaleX(0)';
      void fill.offsetWidth;

      fill.style.transition = 'transform 160ms cubic-bezier(0.1, 0.8, 0.2, 1)';
      fill.style.transform = 'scaleX(1)';

      hideTimeout = setTimeout(function () {
        container.classList.remove('is-active');
        setTimeout(function () {
          fill.style.transition = 'none';
          fill.style.transform = 'scaleX(0)';
        }, 120);
      }, 180);
    }

    // Intercept clicks to start progress bar instantly on click (0ms delay)
    document.addEventListener(
      'click',
      function (e) {
        if (e.defaultPrevented || e.button !== 0) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

        var target = e.target;
        var link = target ? target.closest('a') : null;
        if (!link) return;

        if (link.hasAttribute('data-no-progress') || link.closest('[data-no-progress]')) return;

        var href = link.getAttribute('href');
        if (!href || href.startsWith('javascript:') || href.startsWith('mailto:') || href.startsWith('tel:') || href.startsWith('#')) return;
        if (link.hasAttribute('download')) return;

        var targetAttr = link.getAttribute('target');
        if (targetAttr && targetAttr !== '_self') return;

        try {
          var url = new URL(link.href, window.location.href);
          if (url.origin !== window.location.origin) return;
          if (url.pathname === window.location.pathname && url.search === window.location.search) return;

          // Mark navigation flag for next page
          try {
            sessionStorage.setItem(NAV_KEY, '1');
          } catch (err) {}

          // Start bar instantly on this page before unload
          container.classList.add('is-active');
          fill.style.transition = 'none';
          fill.style.transform = 'scaleX(0)';
          void fill.offsetWidth;

          fill.style.transition = 'transform 160ms cubic-bezier(0.1, 0.8, 0.2, 1)';
          fill.style.transform = 'scaleX(0.75)';

          // Safety timeout in case navigation is cancelled
          setTimeout(function () {
            try { sessionStorage.removeItem(NAV_KEY); } catch (err) {}
            reset();
          }, 1500);
        } catch (err) {}
      },
      { capture: true, passive: true }
    );

    // Bfcache restore
    window.addEventListener('pageshow', function (e) {
      if (e.persisted) reset();
    });
  })();
</script>
