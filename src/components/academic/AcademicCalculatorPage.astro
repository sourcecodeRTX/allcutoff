---
import Layout, { SITE_URL } from '../../layouts/Layout.astro';
import CgpaCalculatorWidget from './CgpaCalculatorWidget.astro';
import SgpaCalculatorWidget from './SgpaCalculatorWidget.astro';
import SgpaToCgpaWidget from './SgpaToCgpaWidget.astro';
import AttendanceWidget from './AttendanceWidget.astro';
import CgpaToPercentageWidget from './CgpaToPercentageWidget.astro';
import MarksPercentageWidget from './MarksPercentageWidget.astro';
import PercentileWidget from './PercentileWidget.astro';
import {
  type AcademicCalculatorMeta,
  getAcademicCalculatorBySlug,
  ACADEMIC_CALCULATORS
} from '../../data/academicCalculators';

interface Props {
  calculator: AcademicCalculatorMeta;
}

const { calculator } = Astro.props;
const siteUrl = SITE_URL;
const canonical = `${siteUrl}/calculator/${calculator.slug}`;
const pageId = `${canonical}#webpage`;
const webappId = `${canonical}#webapp`;
const organizationId = `${siteUrl}/#organization`;
const websiteId = `${siteUrl}/#website`;
const FORMULA_REVIEWED = '2026-10-18';

// Schemas
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Academic Tools', item: `${siteUrl}/tools` },
    { '@type': 'ListItem', position: 3, name: calculator.shortName, item: canonical }
  ]
};

const webPageSchema = {
  '@type': 'WebPage',
  '@id': pageId,
  url: canonical,
  name: `${calculator.title} | All Cut Off`,
  description: calculator.metaDescription,
  inLanguage: 'en-IN',
  dateModified: FORMULA_REVIEWED,
  isPartOf: { '@id': websiteId },
  about: { '@id': webappId },
  breadcrumb: { '@id': `${canonical}#breadcrumb` }
};

const webAppSchema = {
  '@type': 'SoftwareApplication',
  '@id': webappId,
  name: calculator.name,
  alternateName: calculator.shortName,
  url: canonical,
  description: calculator.summary,
  applicationCategory: 'EducationalApplication',
  applicationSubCategory: 'Academic GPA & Rank Calculator',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript',
  inLanguage: 'en-IN',
  isAccessibleForFree: true,
  featureList: [
    'Instant client-side academic calculation',
    'Official UGC / AICTE / University formula compliance',
    'No sign-up, no login, zero data storage',
    'Mobile & desktop responsive interface'
  ],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  publisher: { '@id': organizationId },
  provider: { '@id': organizationId }
};

const faqSchema = calculator.faqs && calculator.faqs.length > 0 ? {
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  isPartOf: { '@id': pageId },
  mainEntity: calculator.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer }
  }))
} : null;

// Related tools
const relatedTools = (calculator.relatedSlugs || [])
  .map((s) => getAcademicCalculatorBySlug(s))
  .filter((c): c is AcademicCalculatorMeta => !!c)
  .slice(0, 4);

const extraSchema = [breadcrumbSchema, webPageSchema, webAppSchema, faqSchema].filter(Boolean);
---

<Layout
  title={`${calculator.title} | All Cut Off`}
  description={calculator.metaDescription}
  canonicalUrl={canonical}
  dateModified={FORMULA_REVIEWED}
  extraSchema={extraSchema}
>
  <!-- Breadcrumb Navigation -->
  <nav aria-label="Breadcrumb" class="border-b border-slate-200 bg-white py-3">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-500">
        <li><a href="/" class="rounded transition-colors hover:text-blue-600">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/tools" class="rounded transition-colors hover:text-blue-600">Academic Tools</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="max-w-[18rem] truncate font-semibold text-slate-900">{calculator.shortName}</li>
      </ol>
    </div>
  </nav>

  <article class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
    <!-- Header Block -->
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-900 px-3 py-1 text-xs font-semibold text-white">
          {calculator.badge}
        </span>
        <span class="rounded-full border border-blue-200 bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-800">
          Academic Year 2025 - 2026
        </span>
        <span class="rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">
          Verified Formula
        </span>
      </div>

      <h1 class="mt-4 text-[1.85rem] font-bold tracking-tight text-slate-900 sm:text-[2.25rem]">
        {calculator.name}
      </h1>

      <p class="mt-3 max-w-[72ch] text-sm leading-relaxed text-slate-700 sm:text-base">
        {calculator.summary}
      </p>

      <!-- Trust signals -->
      <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-medium text-slate-600">
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Instant Client-Side Computation
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-4 w-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          No Sign-up, 100% Free &amp; Private
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-4 w-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          Official Regulation Compliant
        </span>
      </div>
    </div>

    <!-- Interactive Calculator Widget Section -->
    <section id="tool-widget" aria-labelledby="tool-widget-heading" class="mt-8 scroll-mt-24">
      <h2 id="tool-widget-heading" class="sr-only">Interactive {calculator.shortName}</h2>

      {calculator.toolType === 'cgpa' && (
        <CgpaCalculatorWidget initialUniversity={calculator.universityKey} />
      )}
      {calculator.toolType === 'sgpa' && (
        <SgpaCalculatorWidget initialUniversity={calculator.universityKey} />
      )}
      {calculator.toolType === 'sgpa-to-cgpa' && (
        <SgpaToCgpaWidget />
      )}
      {calculator.toolType === 'cgpa-to-percentage' && (
        <CgpaToPercentageWidget initialUniversity={calculator.universityKey} />
      )}
      {calculator.toolType === 'marks-percentage' && (
        <MarksPercentageWidget />
      )}
      {calculator.toolType === 'attendance' && (
        <AttendanceWidget />
      )}
      {calculator.toolType === 'percentile' && (
        <PercentileWidget initialExam={calculator.examKey} />
      )}
    </section>

    <!-- How to Use Section -->
    {calculator.howToUse && calculator.howToUse.length > 0 && (
      <section id="how-to-use" class="mt-14 scroll-mt-24 border-t border-slate-200 pt-10">
        <h2 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">
          How to Use the {calculator.shortName}
        </h2>
        <p class="mt-2 text-sm text-slate-600">
          Follow these quick steps to calculate your accurate results in seconds:
        </p>

        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
          {calculator.howToUse.map((step) => (
            <div class="surface-card flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 shadow-2xs">
              <div>
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600 font-mono text-sm font-bold text-white">
                  {step.stepNumber}
                </span>
                <h3 class="mt-3 text-base font-bold text-slate-900">{step.title}</h3>
                <p class="mt-1.5 text-xs leading-relaxed text-slate-600">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Formula & Mathematics Section -->
    <section id="formula-breakdown" class="mt-14 scroll-mt-24 border-t border-slate-200 pt-10">
      <div class="rounded-2xl border border-slate-200 bg-slate-50/80 p-6 sm:p-8">
        <div class="flex items-center gap-2">
          <span class="rounded bg-blue-100 px-2.5 py-0.5 font-mono text-xs font-bold text-blue-800">MATHEMATICAL RULE</span>
          <span class="text-xs text-slate-500">Official Formula</span>
        </div>

        <h2 class="mt-3 text-xl font-bold tracking-tight text-slate-900">
          Formula &amp; Calculation Rules
        </h2>

        <div class="mt-4 rounded-xl border border-blue-200 bg-white p-4 font-mono text-sm sm:text-base font-bold text-slate-900 shadow-2xs">
          {calculator.verifiedFormulaText}
        </div>

        <div class="mt-4 space-y-3 text-xs sm:text-sm text-slate-700 leading-relaxed">
          <p>
            This calculator implements the official academic formula prescribed by the governing university board or conducting body.
            Calculations adhere to standard UGC/AICTE CBCS guidelines and university academic ordinances without subjective approximations.
          </p>
          <p>
            No data entered into this calculator is ever collected or transmitted. All weighted multiplications and credit summations run entirely in your local browser sandbox.
          </p>
        </div>
      </div>
    </section>

    <!-- Frequently Asked Questions -->
    {calculator.faqs && calculator.faqs.length > 0 && (
      <section id="faq" class="mt-14 scroll-mt-24 border-t border-slate-200 pt-10">
        <h2 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">
          Frequently Asked Questions
        </h2>
        <p class="mt-2 text-sm text-slate-600">
          Authoritative answers to common questions about {calculator.shortName}:
        </p>

        <div class="mt-6 space-y-3">
          {calculator.faqs.map((faq) => (
            <details class="surface-card group rounded-xl border border-slate-200 bg-white p-4 sm:p-5 shadow-2xs">
              <summary class="focus-ring flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
                <span class="text-sm sm:text-base">{faq.question}</span>
                <svg
                  class="h-4 w-4 shrink-0 text-slate-500 transition-transform duration-200 group-open:rotate-180"
                  fill="none" viewBox="0 0 24 24" stroke="currentColor"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <p class="mt-3 text-xs sm:text-sm leading-relaxed text-slate-700 border-t border-slate-100 pt-3">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related Academic Tools -->
    {relatedTools.length > 0 && (
      <section id="related-tools" class="mt-14 scroll-mt-24 border-t border-slate-200 pt-10">
        <h2 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">
          Related Academic &amp; Entrance Calculators
        </h2>
        <p class="mt-2 text-sm text-slate-600">
          Explore other calculators designed for college semesters and competitive exams:
        </p>

        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {relatedTools.map((tool) => (
            <a
              href={`/calculator/${tool.slug}`}
              class="surface-card group rounded-xl border border-slate-200 bg-white p-5 transition-all hover:border-blue-400 hover:shadow-md"
            >
              <div class="flex items-center justify-between">
                <span class="rounded-full bg-blue-50 px-2.5 py-0.5 font-mono text-[0.7rem] font-semibold text-blue-700">
                  {tool.badge}
                </span>
                <svg class="h-4 w-4 text-slate-400 group-hover:text-blue-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
              <h3 class="mt-2 text-base font-bold text-slate-900 group-hover:text-blue-700 transition-colors">
                {tool.name}
              </h3>
              <p class="mt-1.5 text-xs text-slate-600 line-clamp-2">
                {tool.summary}
              </p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Verification / Disclaimer -->
    <section class="mt-14 border-t border-slate-200 pt-10">
      <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5 sm:p-6 text-xs text-slate-700 leading-relaxed">
        <h3 class="text-sm font-bold text-slate-900">Official Disclaimer &amp; Notice</h3>
        <p class="mt-1.5">
          This calculator reproduces published academic regulations and standard UGC/AICTE CBCS mathematical guidelines for educational planning purposes.
          Official degree certificates, transcripts, and grade cards issued by your respective university or board are the sole official record of your academic standing.
        </p>
        <p class="mt-2">
          If your university ordinance has recently revised its conversion formula or credit grading scale, please notify us through our <a href="/contact" class="font-semibold text-blue-700 underline">contact page</a>.
        </p>
      </div>
    </section>
  </article>
</Layout>
