---
import { NEGATIVE_MARKING_PRESETS } from '../../data/academicCalculators';

interface Props {
  idPrefix?: string;
}

const { idPrefix = 'neg-calc' } = Astro.props;
---

<div id={`${idPrefix}-container`} class="surface-card card-accent rounded-2xl p-5 sm:p-7 shadow-sm border border-slate-200 bg-white">
  <!-- Widget Header -->
  <div class="border-b border-slate-200 pb-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-teal-200 bg-teal-50 px-2.5 py-0.5 font-mono text-xs font-semibold text-teal-800">
          <span class="h-1.5 w-1.5 rounded-full bg-teal-600" aria-hidden="true"></span>
          Competitive Exam &amp; Recruitment Suite
        </span>
        <h2 class="mt-2 text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">
          Negative Marking Calculator &amp; Penalty Analyzer
        </h2>
      </div>
      <div class="flex items-center gap-2">
        <span class="rounded-full bg-slate-100 px-3 py-1 font-mono text-xs font-semibold text-slate-700">
          Academic Year 2025–2026
        </span>
      </div>
    </div>
    <p class="mt-2 text-xs sm:text-sm text-slate-600 leading-relaxed max-w-3xl">
      Estimate your exam score precisely and understand how accuracy, mistakes, and negative marking influence your final outcome. Built for serious exam preparation across UPSC, RRB, NEET, SSC, Banking, State PSCs, and JEE.
    </p>

    <!-- Quick Exam Preset Chips (Top horizontal bar) -->
    <div class="mt-5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">
          Tap an exam to auto fill the ratio:
        </span>
        <span class="text-[0.6875rem] text-slate-500 hidden sm:inline">Click any preset to load exam specs</span>
      </div>
      <div class="mt-2.5 flex flex-wrap gap-2" role="tablist" aria-label="Exam Presets">
        {NEGATIVE_MARKING_PRESETS.map((preset, index) => (
          <button
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            data-preset-id={preset.id}
            class={`preset-chip rounded-lg px-3.5 py-1.5 text-xs font-bold transition-all cursor-pointer ${
              index === 0
                ? 'bg-teal-700 text-white shadow-xs border border-teal-800'
                : 'border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 hover:text-slate-900'
            }`}
          >
            {preset.shortName}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Main Calculator Grid: Dual-Column Responsive Dashboard -->
  <div class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-12">
    <!-- LEFT COLUMN: Exam Inputs -->
    <div class="lg:col-span-6 space-y-5">
      <div class="flex items-center justify-between border-b border-slate-100 pb-2">
        <h3 class="text-base font-bold text-slate-900">Exam Inputs</h3>
        <span id={`${idPrefix}-preset-tag`} class="font-mono text-xs text-teal-700 font-semibold bg-teal-50 px-2 py-0.5 rounded">
          UPSC GS Paper 1
        </span>
      </div>

      <!-- Total Questions -->
      <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 transition-colors focus-within:border-teal-600 focus-within:bg-white">
        <div class="flex items-center justify-between">
          <label for={`${idPrefix}-total-questions`} class="text-xs font-bold text-slate-800 uppercase tracking-wide">
            Total Questions
          </label>
          <span class="font-mono text-xs text-slate-500">In Test Paper</span>
        </div>
        <div class="mt-2 flex items-center gap-2">
          <button
            type="button"
            data-step="-5"
            data-target={`${idPrefix}-total-questions`}
            class="step-btn h-9 w-9 shrink-0 rounded-lg border border-slate-200 bg-white font-mono text-base font-bold text-slate-700 hover:bg-slate-100 transition-colors shadow-2xs"
            aria-label="Decrease total questions"
          >
            &minus;
          </button>
          <input
            type="number"
            id={`${idPrefix}-total-questions`}
            min="1"
            max="500"
            value="100"
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-center font-mono text-xl font-bold tabular-nums text-slate-900 outline-none focus:border-teal-600"
          />
          <button
            type="button"
            data-step="5"
            data-target={`${idPrefix}-total-questions`}
            class="step-btn h-9 w-9 shrink-0 rounded-lg border border-slate-200 bg-white font-mono text-base font-bold text-slate-700 hover:bg-slate-100 transition-colors shadow-2xs"
            aria-label="Increase total questions"
          >
            +
          </button>
        </div>
      </div>

      <!-- Maximum Marks -->
      <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 transition-colors focus-within:border-teal-600 focus-within:bg-white">
        <div class="flex items-center justify-between">
          <label for={`${idPrefix}-max-marks`} class="text-xs font-bold text-slate-800 uppercase tracking-wide">
            Maximum Marks
          </label>
          <span id={`${idPrefix}-mpq-preview`} class="font-mono text-xs text-slate-500">2.00 marks / Q</span>
        </div>
        <div class="mt-2 flex items-center gap-2">
          <button
            type="button"
            data-step="-10"
            data-target={`${idPrefix}-max-marks`}
            class="step-btn h-9 w-9 shrink-0 rounded-lg border border-slate-200 bg-white font-mono text-base font-bold text-slate-700 hover:bg-slate-100 transition-colors shadow-2xs"
            aria-label="Decrease maximum marks"
          >
            &minus;
          </button>
          <input
            type="number"
            id={`${idPrefix}-max-marks`}
            min="1"
            max="1500"
            value="200"
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-center font-mono text-xl font-bold tabular-nums text-slate-900 outline-none focus:border-teal-600"
          />
          <button
            type="button"
            data-step="10"
            data-target={`${idPrefix}-max-marks`}
            class="step-btn h-9 w-9 shrink-0 rounded-lg border border-slate-200 bg-white font-mono text-base font-bold text-slate-700 hover:bg-slate-100 transition-colors shadow-2xs"
            aria-label="Increase maximum marks"
          >
            +
          </button>
        </div>
      </div>

      <!-- Questions Attempted -->
      <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 transition-colors focus-within:border-teal-600 focus-within:bg-white">
        <div class="flex items-center justify-between">
          <label for={`${idPrefix}-attempted`} class="text-xs font-bold text-slate-800 uppercase tracking-wide">
            Questions Attempted
          </label>
          <span id={`${idPrefix}-attempt-pct`} class="font-mono text-xs text-slate-500">50% of total</span>
        </div>
        <div class="mt-2 flex items-center gap-2">
          <button
            type="button"
            data-step="-1"
            data-target={`${idPrefix}-attempted`}
            class="step-btn h-9 w-9 shrink-0 rounded-lg border border-slate-200 bg-white font-mono text-base font-bold text-slate-700 hover:bg-slate-100 transition-colors shadow-2xs"
            aria-label="Decrease attempted questions"
          >
            &minus;
          </button>
          <input
            type="number"
            id={`${idPrefix}-attempted`}
            min="0"
            max="500"
            value="50"
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-center font-mono text-xl font-bold tabular-nums text-slate-900 outline-none focus:border-teal-600"
          />
          <button
            type="button"
            data-step="1"
            data-target={`${idPrefix}-attempted`}
            class="step-btn h-9 w-9 shrink-0 rounded-lg border border-slate-200 bg-white font-mono text-base font-bold text-slate-700 hover:bg-slate-100 transition-colors shadow-2xs"
            aria-label="Increase attempted questions"
          >
            +
          </button>
        </div>
      </div>

      <!-- Wrong Answers -->
      <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 transition-colors focus-within:border-rose-600 focus-within:bg-white">
        <div class="flex items-center justify-between">
          <label for={`${idPrefix}-wrong`} class="text-xs font-bold text-rose-800 uppercase tracking-wide">
            Wrong Answers (Mistakes)
          </label>
          <span id={`${idPrefix}-correct-preview`} class="font-mono text-xs font-semibold text-emerald-700">40 Correct</span>
        </div>
        <div class="mt-2 flex items-center gap-2">
          <button
            type="button"
            data-step="-1"
            data-target={`${idPrefix}-wrong`}
            class="step-btn h-9 w-9 shrink-0 rounded-lg border border-slate-200 bg-white font-mono text-base font-bold text-slate-700 hover:bg-slate-100 transition-colors shadow-2xs"
            aria-label="Decrease wrong answers"
          >
            &minus;
          </button>
          <input
            type="number"
            id={`${idPrefix}-wrong`}
            min="0"
            max="500"
            value="10"
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-center font-mono text-xl font-bold tabular-nums text-rose-700 outline-none focus:border-rose-500"
          />
          <button
            type="button"
            data-step="1"
            data-target={`${idPrefix}-wrong`}
            class="step-btn h-9 w-9 shrink-0 rounded-lg border border-slate-200 bg-white font-mono text-base font-bold text-slate-700 hover:bg-slate-100 transition-colors shadow-2xs"
            aria-label="Increase wrong answers"
          >
            +
          </button>
        </div>
      </div>

      <!-- Negative Marking Ratio Dropdown -->
      <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4 transition-colors focus-within:border-teal-600 focus-within:bg-white">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <label for={`${idPrefix}-ratio-select`} class="text-xs font-bold text-slate-800 uppercase tracking-wide">
              Negative Marking Ratio
            </label>
            <!-- Info tooltip trigger -->
            <button
              type="button"
              id={`${idPrefix}-tooltip-btn`}
              class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-slate-200 text-[0.625rem] font-bold text-slate-600 hover:bg-slate-300"
              title="Click to view marking ratio rules"
              aria-label="Marking ratio explanation"
            >
              ?
            </button>
          </div>
          <span id={`${idPrefix}-penalty-per-wrong`} class="font-mono text-xs font-semibold text-rose-700">-0.66 marks/wrong</span>
        </div>

        <select
          id={`${idPrefix}-ratio-select`}
          class="mt-2.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-xs font-semibold text-slate-900 shadow-2xs outline-none focus:border-teal-600 focus:ring-1 focus:ring-teal-600"
        >
          <option value="0.3333333333333333" selected>1/3 (UPSC, RRB, CDS, UPPSC)</option>
          <option value="0.25">1/4 (SSC, Banking, NEET, JEE)</option>
          <option value="0.2">1/5 (State PSC 5-Option Tests)</option>
          <option value="0.5">1/2 (High Penalty Exams)</option>
          <option value="0">No Penalty (MHT CET, KCET, State BEd)</option>
          <option value="custom">Custom Deduction Marks</option>
        </select>

        <!-- Custom Deduction Input (Revealed only when 'custom' selected) -->
        <div id={`${idPrefix}-custom-deduction-wrap`} class="mt-3 hidden">
          <label for={`${idPrefix}-custom-penalty-input`} class="block text-[0.6875rem] font-semibold text-slate-600">
            Deduction Marks Per Incorrect Answer:
          </label>
          <input
            type="number"
            id={`${idPrefix}-custom-penalty-input`}
            step="0.01"
            min="0"
            max="50"
            value="0.66"
            class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm font-semibold text-slate-900 outline-none focus:border-teal-600"
          />
        </div>

        <!-- Tooltip Explainer Popover -->
        <div id={`${idPrefix}-tooltip-popover`} class="mt-2 hidden rounded-lg border border-slate-200 bg-slate-900 p-3 text-xs text-white shadow-lg">
          <p class="font-semibold text-amber-300">Marks Deducted per Wrong Answer:</p>
          <p class="mt-1 leading-relaxed text-slate-200">
            Expressed as a fraction of marks awarded per question. UPSC and Railway use 1/3, SSC and Banks use 1/4, and NEET uses 1/4 (-1 mark out of 4). Unattempted questions carry zero penalty.
          </p>
        </div>
      </div>

      <!-- Action Buttons Row -->
      <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
        <button
          type="button"
          id={`${idPrefix}-calc-btn`}
          class="flex-1 inline-flex items-center justify-center gap-2 rounded-xl bg-teal-700 px-5 py-3 text-sm font-bold text-white shadow-xs hover:bg-teal-800 transition-colors cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          Calculate My Score
        </button>

        <button
          type="button"
          id={`${idPrefix}-clear-btn`}
          class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-200 bg-white px-4 py-3 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer"
        >
          Clear Inputs
        </button>
      </div>

      <!-- Secondary Action Utilities (Print & Share) -->
      <div class="flex items-center gap-2 pt-1">
        <button
          type="button"
          id={`${idPrefix}-print-btn`}
          class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-medium text-slate-700 hover:bg-white hover:border-slate-300 transition-all cursor-pointer"
          title="Print or save as PDF"
        >
          <svg class="h-3.5 w-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          Download PDF / Print
        </button>

        <button
          type="button"
          id={`${idPrefix}-whatsapp-btn`}
          class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-semibold text-emerald-800 hover:bg-emerald-100 transition-all cursor-pointer"
          title="Share results on WhatsApp"
        >
          <svg class="h-3.5 w-3.5 text-emerald-600 fill-current" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.301-.15-1.78-.879-2.056-.979-.276-.1-.477-.15-.678.15-.201.3-.778.979-.954 1.18-.176.2-.351.226-.653.075-.301-.15-1.272-.469-2.423-1.496-.897-.8-1.503-1.788-1.68-2.089-.176-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.176.201-.301.301-.502.1-.2.05-.376-.025-.526-.075-.15-.678-1.635-.929-2.239-.245-.589-.494-.509-.679-.519l-.579-.01c-.2 0-.527.075-.803.376s-1.054 1.03-1.054 2.511c0 1.481 1.079 2.91 1.23 3.111.15.201 2.124 3.243 5.145 4.548.719.311 1.28.497 1.718.636.722.23 1.378.197 1.9-.12.57-.348 1.78-7.27 2.03-1.43.251-.703.251-1.305.176-1.43-.075-.126-.276-.201-.577-.351z"/>
            <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2.05 21.95l4.908-1.287A9.96 9.96 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.182c-1.63 0-3.15-.477-4.43-1.3l-.317-.206-3.29.863.878-3.208-.225-.333A8.136 8.136 0 013.818 12C3.818 7.489 7.489 3.818 12 3.818 16.511 3.818 20.182 7.489 20.182 12c0 4.511-3.671 8.182-8.182 8.182z"/>
          </svg>
          Share on WhatsApp
        </button>
      </div>
    </div>

    <!-- RIGHT COLUMN: Instant Results Dashboard -->
    <div class="lg:col-span-6 space-y-5">
      <!-- NET SCORE Hero Card -->
      <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 shadow-xs transition-all">
        <div class="flex items-center justify-between">
          <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-500">
            NET SCORE
          </span>
          <span id={`${idPrefix}-score-pct-badge`} class="rounded-full bg-teal-100 px-2.5 py-0.5 font-mono text-xs font-bold text-teal-800">
            40.0%
          </span>
        </div>

        <div class="mt-2 flex items-baseline gap-2">
          <span id={`${idPrefix}-net-score-display`} class="font-mono text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
            80.00
          </span>
          <span id={`${idPrefix}-out-of-display`} class="font-mono text-sm font-semibold text-slate-500">
            / 200
          </span>
        </div>

        <!-- Score Visual Progress Bar -->
        <div class="mt-4 h-2 w-full overflow-hidden rounded-full bg-slate-200">
          <div
            id={`${idPrefix}-progress-bar`}
            class="h-full rounded-full bg-teal-600 transition-all duration-300"
            style="width: 40%;"
            role="progressbar"
            aria-valuenow="40"
            aria-valuemin="0"
            aria-valuemax="100"
          ></div>
        </div>
      </div>

      <!-- Penalty Status Banner -->
      <div id={`${idPrefix}-penalty-banner`} class="rounded-xl border border-teal-200 bg-teal-50/80 p-4 transition-all">
        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-teal-600 text-white text-xs font-bold">
            ✓
          </span>
          <div>
            <div id={`${idPrefix}-banner-title`} class="text-xs font-bold uppercase tracking-wider text-teal-900">
              Score Analysis &amp; Deduction
            </div>
            <p id={`${idPrefix}-banner-text`} class="mt-1 text-xs leading-relaxed text-teal-800">
              Negative marking deducted <strong id={`${idPrefix}-banner-lost-marks`}>6.60 marks</strong> from your gross score of 80.00. Accuracy: 80.0%.
            </p>
          </div>
        </div>
      </div>

      <!-- 6-Metric Stats Grid -->
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-2">
        <!-- 1. Correct -->
        <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-2xs">
          <div class="text-[0.6875rem] font-bold uppercase tracking-wider text-slate-500">Correct</div>
          <div id={`${idPrefix}-stat-correct`} class="mt-1 font-mono text-2xl font-bold text-emerald-600">40</div>
          <div id={`${idPrefix}-stat-gross`} class="text-[0.6875rem] text-slate-500 font-mono">+80.00 marks gross</div>
        </div>

        <!-- 2. Wrong -->
        <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-2xs">
          <div class="text-[0.6875rem] font-bold uppercase tracking-wider text-slate-500">Wrong</div>
          <div id={`${idPrefix}-stat-wrong`} class="mt-1 font-mono text-2xl font-bold text-rose-600">10</div>
          <div id={`${idPrefix}-stat-deduction`} class="text-[0.6875rem] text-rose-600 font-mono">-6.60 marks penalty</div>
        </div>

        <!-- 3. Unattempted -->
        <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-2xs">
          <div class="text-[0.6875rem] font-bold uppercase tracking-wider text-slate-500">Unattempted</div>
          <div id={`${idPrefix}-stat-unattempted`} class="mt-1 font-mono text-2xl font-bold text-slate-700">50</div>
          <div class="text-[0.6875rem] text-slate-500 font-mono">0 marks (No risk)</div>
        </div>

        <!-- 4. Accuracy -->
        <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-2xs">
          <div class="flex items-center justify-between">
            <span class="text-[0.6875rem] font-bold uppercase tracking-wider text-slate-500">Accuracy</span>
            <span id={`${idPrefix}-stat-accuracy-tag`} class="text-[0.625rem] font-bold px-1.5 py-0.2 rounded bg-emerald-100 text-emerald-800">
              Good
            </span>
          </div>
          <div id={`${idPrefix}-stat-accuracy`} class="mt-1 font-mono text-2xl font-bold text-slate-900">80.0%</div>
          <div class="text-[0.6875rem] text-slate-500 font-mono">Correct / Attempted</div>
        </div>

        <!-- 5. Break-Even Accuracy -->
        <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-2xs">
          <div class="flex items-center justify-between">
            <span class="text-[0.6875rem] font-bold uppercase tracking-wider text-slate-500">Break-Even Accuracy</span>
            <span class="text-[0.625rem] font-mono text-slate-400" title="Accuracy needed for expected return > 0">ⓘ</span>
          </div>
          <div id={`${idPrefix}-stat-breakeven`} class="mt-1 font-mono text-2xl font-bold text-slate-900">25.0%</div>
          <div class="text-[0.6875rem] text-slate-500 font-mono">Min guessing hurdle</div>
        </div>

        <!-- 6. Marks per Attempt -->
        <div class="rounded-xl border border-slate-200 bg-white p-3.5 shadow-2xs">
          <div class="flex items-center justify-between">
            <span class="text-[0.6875rem] font-bold uppercase tracking-wider text-slate-500">Marks per Attempt</span>
            <span class="text-[0.625rem] font-mono text-slate-400" title="Average net marks earned per question attempted">ⓘ</span>
          </div>
          <div id={`${idPrefix}-stat-mpa`} class="mt-1 font-mono text-2xl font-bold text-teal-700">1.60</div>
          <div class="text-[0.6875rem] text-slate-500 font-mono">Efficiency metric</div>
        </div>
      </div>

      <!-- Step-by-Step Calculation Formula Card -->
      <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 text-xs">
        <div class="font-bold text-slate-900 uppercase tracking-wider">
          Step-by-Step Mathematical Calculation:
        </div>
        <div class="mt-2 space-y-1.5 font-mono text-[0.8125rem] text-slate-800">
          <div class="flex items-center justify-between border-b border-slate-200/60 pb-1">
            <span>Positive Marks (Gross):</span>
            <span id={`${idPrefix}-step-gross`} class="font-bold text-emerald-700">40 × 2.00 = +80.00</span>
          </div>
