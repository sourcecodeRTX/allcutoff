    // Screen Output Elements
    const netScoreDisplay = document.getElementById(`${idPrefix}-net-score-display`);
    const outOfDisplay = document.getElementById(`${idPrefix}-out-of-display`);
    const scorePctBadge = document.getElementById(`${idPrefix}-score-pct-badge`);
    const progressBar = document.getElementById(`${idPrefix}-progress-bar`);
    const banner = document.getElementById(`${idPrefix}-penalty-banner`);
    const bannerTitle = document.getElementById(`${idPrefix}-banner-title`);
    const bannerText = document.getElementById(`${idPrefix}-banner-text`);
    const bannerLostMarks = document.getElementById(`${idPrefix}-banner-lost-marks`);

    const statCorrect = document.getElementById(`${idPrefix}-stat-correct`);
    const statGross = document.getElementById(`${idPrefix}-stat-gross`);
    const statWrong = document.getElementById(`${idPrefix}-stat-wrong`);
    const statDeduction = document.getElementById(`${idPrefix}-stat-deduction`);
    const statUnattempted = document.getElementById(`${idPrefix}-stat-unattempted`);
    const statAccuracy = document.getElementById(`${idPrefix}-stat-accuracy`);
    const statAccuracyTag = document.getElementById(`${idPrefix}-stat-accuracy-tag`);
    const statBreakeven = document.getElementById(`${idPrefix}-stat-breakeven`);
    const statMpa = document.getElementById(`${idPrefix}-stat-mpa`);

    const stepGross = document.getElementById(`${idPrefix}-step-gross`);
    const stepPenalty = document.getElementById(`${idPrefix}-step-penalty`);
    const stepNet = document.getElementById(`${idPrefix}-step-net`);

    const calcBtn = document.getElementById(`${idPrefix}-calc-btn`);
    const clearBtn = document.getElementById(`${idPrefix}-clear-btn`);
    const printBtn = document.getElementById(`${idPrefix}-print-btn`);
    const whatsappBtn = document.getElementById(`${idPrefix}-whatsapp-btn`);
    const saveResultBtn = document.getElementById(`${idPrefix}-save-result-btn`);
    const historyList = document.getElementById(`${idPrefix}-history-list`);

    let currentPreset = presets[0];

    // Helper: Determine human-friendly ratio label
    function getRatioLabel(ratioVal) {
      const val = parseFloat(ratioVal);
      if (Math.abs(val - 1) < 0.001) return '1/1 (Full mark)';
      if (Math.abs(val - 0.5) < 0.001) return '1/2';
      if (Math.abs(val - 1/3) < 0.005) return '1/3rd';
      if (Math.abs(val - 0.25) < 0.001) return '1/4th';
      if (Math.abs(val - 0.2) < 0.001) return '1/5th';
      if (Math.abs(val - 1/6) < 0.005) return '1/6th';
      if (val === 0) return 'No Penalty';
      return 'Custom Rate';
    }

    // Helper: Update the Dedicated Printable Scorecard DOM
    function updatePrintReport(data) {
      const { totalQ, maxMarks, mpq, penalty, penaltyDisplay, ratioLabel, attempted, wrong, correct, unattempted, gross, deduction, net, scorePct, accuracy, breakeven, mpa } = data;

      const printExamName = document.getElementById(`${idPrefix}-print-exam-name`);
      if (printExamName) printExamName.textContent = currentPreset ? currentPreset.name : 'Competitive Exam';

      const printDateTime = document.getElementById(`${idPrefix}-print-datetime`);
      if (printDateTime) {
        const now = new Date();
        const dateStr = now.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
        const timeStr = now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });
        printDateTime.textContent = `${dateStr} • ${timeStr}`;
      }

      const printCfgTotal = document.getElementById(`${idPrefix}-print-cfg-total`);
      if (printCfgTotal) printCfgTotal.textContent = `${totalQ} Questions`;

      const printCfgMax = document.getElementById(`${idPrefix}-print-cfg-max`);
      if (printCfgMax) printCfgMax.textContent = `${maxMarks.toFixed(2)} Marks`;

      const printCfgMpq = document.getElementById(`${idPrefix}-print-cfg-mpq`);
      if (printCfgMpq) printCfgMpq.textContent = `+${mpq.toFixed(2)} Marks`;

      const printCfgPenalty = document.getElementById(`${idPrefix}-print-cfg-penalty`);
      if (printCfgPenalty) {
        printCfgPenalty.textContent = penalty > 0 ? `-${penalty.toFixed(2)} Marks (${ratioLabel})` : '0.00 (No Penalty)';
      }

      const printAttCount = document.getElementById(`${idPrefix}-print-att-count`);
      if (printAttCount) printAttCount.textContent = String(attempted);

      const printAttPct = document.getElementById(`${idPrefix}-print-att-pct`);
      if (printAttPct) printAttPct.textContent = `${Math.round((attempted / totalQ) * 100)}% of test paper`;

      const printCorrectCount = document.getElementById(`${idPrefix}-print-correct-count`);
      if (printCorrectCount) printCorrectCount.textContent = String(correct);

      const printCorrectSub = document.getElementById(`${idPrefix}-print-correct-sub`);
      if (printCorrectSub) printCorrectSub.textContent = `+${gross.toFixed(2)} gross earned`;

      const printWrongCount = document.getElementById(`${idPrefix}-print-wrong-count`);
      if (printWrongCount) printWrongCount.textContent = String(wrong);

      const printWrongSub = document.getElementById(`${idPrefix}-print-wrong-sub`);
      if (printWrongSub) printWrongSub.textContent = `-${deduction.toFixed(2)} penalty lost`;

      const printUnattCount = document.getElementById(`${idPrefix}-print-unatt-count`);
      if (printUnattCount) printUnattCount.textContent = String(unattempted);

      const printUnattSub = document.getElementById(`${idPrefix}-print-unatt-sub`);
      if (printUnattSub) printUnattSub.textContent = `${Math.round((unattempted / totalQ) * 100)}% skipped (0 risk)`;

      const printNetScore = document.getElementById(`${idPrefix}-print-net-score`);
      if (printNetScore) printNetScore.textContent = net.toFixed(2);

      const printNetMax = document.getElementById(`${idPrefix}-print-net-max`);
      if (printNetMax) printNetMax.textContent = `/ ${maxMarks.toFixed(2)}`;

      const printNetPct = document.getElementById(`${idPrefix}-print-net-pct`);
      if (printNetPct) printNetPct.textContent = `${scorePct.toFixed(1)}%`;

      const printProgressBar = document.getElementById(`${idPrefix}-print-progress-bar`);
      if (printProgressBar) {
        const clampedPct = Math.max(0, Math.min(100, scorePct));
        printProgressBar.style.width = `${clampedPct}%`;
      }

      const printHeroGross = document.getElementById(`${idPrefix}-print-hero-gross`);
      if (printHeroGross) printHeroGross.textContent = `+${gross.toFixed(2)} Marks`;

      const printHeroLoss = document.getElementById(`${idPrefix}-print-hero-loss`);
      if (printHeroLoss) printHeroLoss.textContent = `-${deduction.toFixed(2)} Marks`;

      const printHeroRatio = document.getElementById(`${idPrefix}-print-hero-ratio`);
      if (printHeroRatio) {
        printHeroRatio.textContent = gross > 0 ? `${((deduction / gross) * 100).toFixed(1)}% of gross` : '0.0% of gross';
      }

      const printBanner = document.getElementById(`${idPrefix}-print-banner`);
      const printBannerText = document.getElementById(`${idPrefix}-print-banner-text`);
      const printBannerIcon = document.getElementById(`${idPrefix}-print-banner-icon`);
      if (printBanner && printBannerText && printBannerIcon) {
        if (penalty === 0) {
          printBanner.className = 'pdf-banner pdf-banner-emerald';
          printBannerIcon.textContent = '✓';
          printBannerText.innerHTML = `<strong>NO PENALTY SCHEME:</strong> Every correct response yields full marks with zero deduction risk for mistakes. Attempted ${attempted} of ${totalQ} questions with ${accuracy.toFixed(1)}% accuracy.`;
        } else if (attempted === 0) {
          printBanner.className = 'pdf-banner pdf-banner-slate';
          printBannerIcon.textContent = 'ℹ';
          printBannerText.textContent = `No questions attempted yet. Enter questions attempted and mistakes in the test calculator to view negative marking penalty analysis.`;
        } else if (accuracy >= breakeven) {
          printBanner.className = 'pdf-banner pdf-banner-teal';
          printBannerIcon.textContent = '✓';
          const lossShare = gross > 0 ? Math.round((deduction / gross) * 100) : 0;
          printBannerText.innerHTML = `<strong>POSITIVE GUESSING RETURN:</strong> Your accuracy (${accuracy.toFixed(1)}%) safely exceeded the ${breakeven.toFixed(1)}% break-even hurdle. Mistakes deducted <strong>${deduction.toFixed(2)} marks</strong> (${lossShare}% of gross score).`;
        } else {
          printBanner.className = 'pdf-banner pdf-banner-rose';
          printBannerIcon.textContent = '⚠';
          printBannerText.innerHTML = `<strong>CRITICAL PENALTY EROSION:</strong> Mistakes severely damaged your score, deducting <strong>${deduction.toFixed(2)} marks</strong>. Your accuracy (${accuracy.toFixed(1)}%) fell below the ${breakeven.toFixed(1)}% break-even hurdle.`;
        }
      }

      const printAccVal = document.getElementById(`${idPrefix}-print-acc-val`);
      if (printAccVal) printAccVal.textContent = `${accuracy.toFixed(1)}%`;

      const printAccTag = document.getElementById(`${idPrefix}-print-acc-tag`);
      if (printAccTag) {
        if (accuracy >= 80) {
          printAccTag.textContent = 'High';
          printAccTag.className = 'pdf-tag pdf-tag-emerald';
        } else if (accuracy >= breakeven) {
          printAccTag.textContent = 'Solid';
          printAccTag.className = 'pdf-tag pdf-tag-teal';
        } else {
          printAccTag.textContent = 'Risk';
          printAccTag.className = 'pdf-tag pdf-tag-rose';
        }
      }

      const printBeVal = document.getElementById(`${idPrefix}-print-be-val`);
      if (printBeVal) printBeVal.textContent = `${breakeven.toFixed(1)}%`;

      const printMpaVal = document.getElementById(`${idPrefix}-print-mpa-val`);
      if (printMpaVal) printMpaVal.textContent = `${mpa.toFixed(2)} marks/Q`;

      const printErosionVal = document.getElementById(`${idPrefix}-print-erosion-val`);
      if (printErosionVal) {
        printErosionVal.textContent = gross > 0 ? `${((deduction / gross) * 100).toFixed(1)}%` : '0.0%';
      }

      const printStepGross = document.getElementById(`${idPrefix}-print-step-gross`);
      if (printStepGross) printStepGross.textContent = `${correct} Correct × ${mpq.toFixed(2)} = +${gross.toFixed(2)} marks`;

      const printStepLoss = document.getElementById(`${idPrefix}-print-step-loss`);
      if (printStepLoss) printStepLoss.textContent = `${wrong} Mistakes × ${penaltyDisplay} = -${deduction.toFixed(2)} marks`;

      const printStepNet = document.getElementById(`${idPrefix}-print-step-net`);
      if (printStepNet) printStepNet.textContent = `${gross.toFixed(2)} - ${deduction.toFixed(2)} = ${net.toFixed(2)} marks`;

      const printStepPct = document.getElementById(`${idPrefix}-print-step-pct`);
      if (printStepPct) printStepPct.textContent = `(${net.toFixed(2)} ÷ ${maxMarks.toFixed(2)}) × 100 = ${scorePct.toFixed(2)}%`;

      const printTblCCnt = document.getElementById(`${idPrefix}-print-tbl-c-cnt`);
      if (printTblCCnt) printTblCCnt.textContent = String(correct);
      const printTblCPct = document.getElementById(`${idPrefix}-print-tbl-c-pct`);
      if (printTblCPct) printTblCPct.textContent = `${Math.round((correct / totalQ) * 100)}%`;
      const printTblCMrk = document.getElementById(`${idPrefix}-print-tbl-c-mrk`);
      if (printTblCMrk) printTblCMrk.textContent = `+${gross.toFixed(2)}`;

      const printTblWCnt = document.getElementById(`${idPrefix}-print-tbl-w-cnt`);
      if (printTblWCnt) printTblWCnt.textContent = String(wrong);
      const printTblWPct = document.getElementById(`${idPrefix}-print-tbl-w-pct`);
      if (printTblWPct) printTblWPct.textContent = `${Math.round((wrong / totalQ) * 100)}%`;
      const printTblWMrk = document.getElementById(`${idPrefix}-print-tbl-w-mrk`);
      if (printTblWMrk) printTblWMrk.textContent = `-${deduction.toFixed(2)}`;

      const printTblUCnt = document.getElementById(`${idPrefix}-print-tbl-u-cnt`);
      if (printTblUCnt) printTblUCnt.textContent = String(unattempted);
      const printTblUPct = document.getElementById(`${idPrefix}-print-tbl-u-pct`);
      if (printTblUPct) printTblUPct.textContent = `${Math.round((unattempted / totalQ) * 100)}%`;

      const printTblTotCnt = document.getElementById(`${idPrefix}-print-tbl-tot-cnt`);
      if (printTblTotCnt) printTblTotCnt.textContent = String(totalQ);
      const printTblTotNet = document.getElementById(`${idPrefix}-print-tbl-tot-net`);
      if (printTblTotNet) printTblTotNet.textContent = `${net.toFixed(2)} Net`;

      const printRecomList = document.getElementById(`${idPrefix}-print-recom-list`);
      if (printRecomList) {
        let rec1 = '';
        if (accuracy >= 80) {
          rec1 = `<strong>Accuracy Discipline:</strong> Excellent accuracy (${accuracy.toFixed(1)}%). Under real exam pressure, maintain this strong threshold and resist speculative guessing near the final minutes.`;
        } else if (accuracy >= breakeven) {
          rec1 = `<strong>Error Minimization:</strong> Solid accuracy (${accuracy.toFixed(1)}%), safely exceeding the ${breakeven.toFixed(1)}% hurdle. Eliminating just 3 to 5 unforced errors will recover +${(deduction * 0.4).toFixed(2)} marks into your net score.`;
        } else {
          rec1 = `<strong>Penalty Warning:</strong> Accuracy (${accuracy.toFixed(1)}%) is below the ${breakeven.toFixed(1)}% break-even hurdle. Blind guessing is actively reducing your score. Attempt only questions where at least two options are definitively eliminated.`;
        }

        let rec2 = `<strong>Option Elimination Rule:</strong> On 4-option questions with ${ratioLabel} penalty, blind guessing yields 0.00 expected value. Eliminating 2 incorrect options raises expected value to positive territory (+0.67 marks per question in 2-mark tests).`;

        let rec3 = '';
        if (unattempted > 0) {
          rec3 = `<strong>Unattempted Question Audit:</strong> ${unattempted} questions (${Math.round((unattempted / totalQ) * 100)}% of paper) were skipped. Practice timed mock rounds to verify whether time deficit or question selection was the bottleneck.`;
        } else {
          rec3 = `<strong>Attempt Discipline:</strong> You attempted 100% of the paper. Confirm that low-conviction guesses in difficult sections did not result in negative score erosion.`;
        }

        printRecomList.innerHTML = `<li>${rec1}</li><li>${rec2}</li><li>${rec3}</li>`;
      }
    }

    function calculate() {
      const totalQ = Math.max(1, parseInt(totalQInput.value, 10) || 100);
      const maxMarks = Math.max(1, parseFloat(maxMarksInput.value) || 100);
      let attempted = parseInt(attemptedInput.value, 10);
      if (isNaN(attempted)) attempted = 0;
      attempted = Math.max(0, Math.min(totalQ, attempted));

      let wrong = parseInt(wrongInput.value, 10);
      if (isNaN(wrong)) wrong = 0;
      wrong = Math.max(0, Math.min(attempted, wrong));

      const correct = Math.max(0, attempted - wrong);
      const unattempted = Math.max(0, totalQ - attempted);

      const mpq = maxMarks / totalQ;
      let penalty = 0;
      let penaltyDisplay = '';

      if (ratioSelect.value === 'custom') {
        penalty = Math.max(0, parseFloat(customPenaltyInput.value) || 0);
        penaltyDisplay = penalty.toFixed(2);
      } else {
        const ratio = parseFloat(ratioSelect.value) || 0;
        penalty = mpq * ratio;
        // If penalty is an uneven fraction like 2/3 (0.6666...), format with 3 decimals so (wrong × penalty = deduction) is mathematically sound!
        const isFractional = (Math.abs(penalty * 100 - Math.round(penalty * 100)) > 0.001);
        penaltyDisplay = isFractional ? penalty.toFixed(3) : penalty.toFixed(2);
      }

      const gross = Math.round(correct * mpq * 100) / 100;
      const deduction = Math.round(wrong * penalty * 100) / 100;
      const net = Math.round((gross - deduction) * 100) / 100;
      const scorePct = Math.round((net / maxMarks) * 10000) / 100;
      const accuracy = attempted > 0 ? Math.round((correct / attempted) * 10000) / 100 : 0;
      const breakeven = (mpq + penalty) > 0 ? Math.round((penalty / (mpq + penalty)) * 10000) / 100 : 0;
      const mpa = attempted > 0 ? Math.round((net / attempted) * 100) / 100 : 0;
      const ratioLabel = getRatioLabel(ratioSelect.value);

      // Update previews in input labels
      if (mpqPreview) mpqPreview.textContent = `${mpq.toFixed(2)} marks / Q`;
      if (attemptPct) attemptPct.textContent = `${Math.round((attempted / totalQ) * 100)}% of total`;
      if (correctPreview) correctPreview.textContent = `${correct} Correct`;
      if (penaltyPerWrong) penaltyPerWrong.textContent = penalty > 0 ? `-${penalty.toFixed(2)} marks/wrong` : 'No deduction';

      // Update Net Score Hero on Screen
      if (netScoreDisplay) netScoreDisplay.textContent = net.toFixed(2);
      if (outOfDisplay) outOfDisplay.textContent = `/ ${maxMarks}`;
      if (scorePctBadge) {
        scorePctBadge.textContent = `${scorePct.toFixed(1)}%`;
        if (scorePct >= 60) {
          scorePctBadge.className = 'rounded-full bg-emerald-100 px-2.5 py-0.5 font-mono text-xs font-bold text-emerald-800';
        } else if (scorePct >= 35) {
          scorePctBadge.className = 'rounded-full bg-teal-100 px-2.5 py-0.5 font-mono text-xs font-bold text-teal-800';
        } else {
          scorePctBadge.className = 'rounded-full bg-rose-100 px-2.5 py-0.5 font-mono text-xs font-bold text-rose-800';
        }
      }

      if (progressBar) {
        const barWidth = Math.max(0, Math.min(100, scorePct));
        progressBar.style.width = `${barWidth}%`;
        progressBar.setAttribute('aria-valuenow', String(barWidth));
        if (scorePct >= 60) {
          progressBar.className = 'h-full rounded-full bg-emerald-600 transition-all duration-300';
        } else if (scorePct >= 35) {
          progressBar.className = 'h-full rounded-full bg-teal-600 transition-all duration-300';
        } else {
          progressBar.className = 'h-full rounded-full bg-rose-600 transition-all duration-300';
        }
      }

      // Update Screen Penalty Banner
      if (banner && bannerText && bannerTitle) {
        if (penalty === 0) {
          banner.className = 'rounded-xl border border-emerald-200 bg-emerald-50/80 p-4 transition-all';
          bannerTitle.className = 'text-xs font-bold uppercase tracking-wider text-emerald-900';
          bannerTitle.textContent = 'NO PENALTY: FULL REWARD';
          bannerText.className = 'mt-1 text-xs leading-relaxed text-emerald-800';
          bannerText.innerHTML = `No negative marking on this exam! Every attempt adds to your score without any penalty risk. Attempt all ${totalQ} questions.`;
        } else if (attempted === 0) {
          banner.className = 'rounded-xl border border-slate-200 bg-slate-50 p-4 transition-all';
          bannerTitle.className = 'text-xs font-bold uppercase tracking-wider text-slate-700';
          bannerTitle.textContent = 'TEST SPECIFICATIONS READY';
          bannerText.className = 'mt-1 text-xs leading-relaxed text-slate-600';
          bannerText.textContent = `Enter your questions attempted and wrong answers to view negative marking deductions.`;
        } else if (accuracy >= breakeven) {
          banner.className = 'rounded-xl border border-teal-200 bg-teal-50/80 p-4 transition-all';
          bannerTitle.className = 'text-xs font-bold uppercase tracking-wider text-teal-900';
          bannerTitle.textContent = 'POSITIVE GUESSING RETURN';
          bannerText.className = 'mt-1 text-xs leading-relaxed text-teal-800';
          bannerText.innerHTML = `Negative marking deducted <strong>${deduction.toFixed(2)} marks</strong> (${Math.round((deduction / (gross || 1)) * 100)}% of gross score). Accuracy: <strong>${accuracy.toFixed(1)}%</strong> exceeds break-even (${breakeven.toFixed(1)}%).`;
        } else {
          banner.className = 'rounded-xl border border-rose-200 bg-rose-50/80 p-4 transition-all';
          bannerTitle.className = 'text-xs font-bold uppercase tracking-wider text-rose-900';
          bannerTitle.textContent = 'CRITICAL PENALTY IMPACT';
          bannerText.className = 'mt-1 text-xs leading-relaxed text-rose-800';
          bannerText.innerHTML = `Negative marking severely eroded your score! <strong>${deduction.toFixed(2)} marks deducted</strong>. Your accuracy (${accuracy.toFixed(1)}%) is below the ${breakeven.toFixed(1)}% break-even mark.`;
        }
      }

      // Screen Stats Grid
      if (statCorrect) statCorrect.textContent = String(correct);
      if (statGross) statGross.textContent = `+${gross.toFixed(2)} marks gross`;
      if (statWrong) statWrong.textContent = String(wrong);
      if (statDeduction) statDeduction.textContent = `-${deduction.toFixed(2)} marks penalty`;
      if (statUnattempted) statUnattempted.textContent = String(unattempted);
      if (statAccuracy) statAccuracy.textContent = `${accuracy.toFixed(1)}%`;
      if (statAccuracyTag) {
        if (accuracy >= 80) {
          statAccuracyTag.textContent = 'High';
          statAccuracyTag.className = 'text-[0.625rem] font-bold px-1.5 py-0.2 rounded bg-emerald-100 text-emerald-800';
        } else if (accuracy >= breakeven) {
          statAccuracyTag.textContent = 'Solid';
          statAccuracyTag.className = 'text-[0.625rem] font-bold px-1.5 py-0.2 rounded bg-teal-100 text-teal-800';
        } else {
          statAccuracyTag.textContent = 'Risk';
          statAccuracyTag.className = 'text-[0.625rem] font-bold px-1.5 py-0.2 rounded bg-rose-100 text-rose-800';
        }
      }
      if (statBreakeven) statBreakeven.textContent = `${breakeven.toFixed(1)}%`;
      if (statMpa) statMpa.textContent = mpa.toFixed(2);

      // Formula breakdown on screen
      if (stepGross) stepGross.textContent = `${correct} × ${mpq.toFixed(2)} = +${gross.toFixed(2)}`;
      if (stepPenalty) stepPenalty.textContent = `${wrong} × ${penaltyDisplay} = -${deduction.toFixed(2)}`;
      if (stepNet) stepNet.textContent = `${gross.toFixed(2)} - ${deduction.toFixed(2)} = ${net.toFixed(2)}`;

      const res = { totalQ, maxMarks, mpq, penalty, penaltyDisplay, ratioLabel, attempted, wrong, correct, unattempted, gross, deduction, net, scorePct, accuracy, breakeven, mpa };

      // Simultaneously update the Dedicated Printable Scorecard DOM
      updatePrintReport(res);

      return res;
    }

    // Step button handlers (+ / -)
    document.querySelectorAll('.step-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const step = parseFloat(btn.getAttribute('data-step') || '1');
        const input = document.getElementById(targetId);
        if (input) {
          const val = (parseFloat(input.value) || 0) + step;
          const min = parseFloat(input.min || '0');
          const max = parseFloat(input.max || '10000');
          input.value = String(Math.max(min, Math.min(max, val)));
          calculate();
        }
      });
    });

    // Input change listeners
    [totalQInput, maxMarksInput, attemptedInput, wrongInput, customPenaltyInput].forEach((inp) => {
      if (inp) {
        inp.addEventListener('input', calculate);
        inp.addEventListener('change', calculate);
      }
    });

    // Ratio dropdown change
    if (ratioSelect) {
      ratioSelect.addEventListener('change', () => {
        if (ratioSelect.value === 'custom') {
          if (customDeductionWrap) customDeductionWrap.classList.remove('hidden');
        } else {
          if (customDeductionWrap) customDeductionWrap.classList.add('hidden');
        }
        calculate();
      });
    }

    // Preset chips click
    document.querySelectorAll('.preset-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const presetId = chip.getAttribute('data-preset-id');
        const found = presets.find((p) => p.id === presetId);
        if (!found) return;

        currentPreset = found;

        // Update active chip classes
        document.querySelectorAll('.preset-chip').forEach((c) => {
          c.classList.remove('bg-teal-700', 'text-white', 'shadow-xs', 'border-teal-800');
          c.classList.add('border-slate-200', 'bg-slate-50', 'text-slate-700');
          c.setAttribute('aria-selected', 'false');
        });
        chip.classList.add('bg-teal-700', 'text-white', 'shadow-xs', 'border-teal-800');
        chip.classList.remove('border-slate-200', 'bg-slate-50', 'text-slate-700');
        chip.setAttribute('aria-selected', 'true');

        // Populate exam specs
        totalQInput.value = String(found.totalQuestions);
        maxMarksInput.value = String(found.maximumMarks);

        // Keep candidate's user-entered attempts if already entered, but clamp to new totalQ; otherwise load preset default
        const currentAtt = parseInt(attemptedInput.value, 10);
        const currentWr = parseInt(wrongInput.value, 10);
        if (isNaN(currentAtt) || currentAtt === 0) {
          attemptedInput.value = String(found.defaultAttempted || 50);
          wrongInput.value = String(found.defaultWrong || 10);
        } else {
          const clampedAtt = Math.min(found.totalQuestions, currentAtt);
          attemptedInput.value = String(clampedAtt);
          wrongInput.value = String(Math.min(clampedAtt, isNaN(currentWr) ? 0 : currentWr));
        }

        if (presetTag) presetTag.textContent = found.name;

        if (found.customPenalty !== undefined) {
          const matchOpt = Array.from(ratioSelect.options).find(
            (opt) => Math.abs(parseFloat(opt.value) - found.penaltyRatio) < 0.001
          );
          if (matchOpt) {
            ratioSelect.value = matchOpt.value;
            if (customDeductionWrap) customDeductionWrap.classList.add('hidden');
          } else {
            ratioSelect.value = 'custom';
            if (customPenaltyInput) customPenaltyInput.value = String(found.customPenalty);
            if (customDeductionWrap) customDeductionWrap.classList.remove('hidden');
          }
        } else {
          const matchOpt = Array.from(ratioSelect.options).find(
            (opt) => Math.abs(parseFloat(opt.value) - found.penaltyRatio) < 0.001
          );
          if (matchOpt) {
            ratioSelect.value = matchOpt.value;
            if (customDeductionWrap) customDeductionWrap.classList.add('hidden');
          }
        }

        calculate();
      });
    });

    // Tooltip toggle
    if (tooltipBtn && tooltipPopover) {
      tooltipBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        tooltipPopover.classList.toggle('hidden');
      });
      document.addEventListener('click', (e) => {
        if (!tooltipPopover.contains(e.target) && e.target !== tooltipBtn) {
          tooltipPopover.classList.add('hidden');
        }
      });
    }

    // Action button triggers
    if (calcBtn) {
      calcBtn.addEventListener('click', () => {
        calculate();
        const heroCard = document.getElementById(`${idPrefix}-net-score-display`);
        if (heroCard) heroCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        attemptedInput.value = '';
        wrongInput.value = '';
        calculate();
      });
    }

    // Download PDF / Print button
    if (printBtn) {
      printBtn.addEventListener('click', () => {
        calculate();
        const prevTitle = document.title;
        const safeExam = (currentPreset?.shortName || 'Scorecard').replace(/[^a-zA-Z0-9_-]/g, '_');
        document.title = `Negative_Marking_Scorecard_${safeExam}_AllCutOff`;
        window.print();
        setTimeout(() => {
          document.title = prevTitle;
        }, 1500);
      });
    }

    // WhatsApp Share button
    if (whatsappBtn) {
      whatsappBtn.addEventListener('click', () => {
        const res = calculate();
        const text = `📊 Exam Score Report (${currentPreset.shortName}):\n` +
          `• Questions Attempted: ${res.attempted} / ${res.totalQ}\n` +
          `• Correct: ${res.correct} | Wrong: ${res.wrong}\n` +
          `• Accuracy: ${res.accuracy.toFixed(1)}%\n` +
          `• Negative Penalty: -${res.deduction.toFixed(2)} marks\n` +
          `• Net Final Score: ${res.net.toFixed(2)} / ${res.maxMarks} (${res.scorePct.toFixed(1)}%)\n\n` +
          `Calculate yours at: https://allcutoff.com/calculator/negative-marking-calculator`;
        window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`, '_blank');
      });
    }

    // Session History storage in localStorage
    const STORAGE_KEY = 'allcutoff_neg_marking_history';

    function renderHistory() {
      if (!historyList) return;
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        const list = raw ? JSON.parse(raw) : [];
        if (!list || list.length === 0) {
          historyList.innerHTML = '<p class="text-slate-400 italic text-[0.6875rem]">No saved attempts yet. Click "Save this result" to compare mock scores.</p>';
          return;
        }

        historyList.innerHTML = list.slice(0, 5).map((item, idx) => `
          <div class="flex items-center justify-between rounded-lg border border-slate-100 bg-slate-50/80 px-2.5 py-1.5">
            <div>
              <span class="font-bold text-slate-800">${item.exam}</span>
              <span class="text-[0.625rem] text-slate-500 ml-1.5">${item.date}</span>
            </div>
            <div class="font-mono text-xs font-bold text-teal-800">
              ${item.score} <span class="text-[0.625rem] text-slate-500">(${item.accuracy}%)</span>
            </div>
          </div>
        `).join('');
      } catch (e) {
        // Safe fallback
      }
    }

    if (saveResultBtn) {
      saveResultBtn.addEventListener('click', () => {
        const res = calculate();
        const entry = {
          exam: currentPreset.shortName,
          date: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
          score: `${res.net.toFixed(2)} / ${res.maxMarks}`,
          accuracy: res.accuracy.toFixed(1)
        };
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          const list = raw ? JSON.parse(raw) : [];
          list.unshift(entry);
          localStorage.setItem(STORAGE_KEY, JSON.stringify(list.slice(0, 10)));
          renderHistory();
        } catch (e) {}
      });
    }

    // Initial calculation and history render
    calculate();
    renderHistory();
  })();
</script>

