    const tooltipBtn = document.getElementById(`${idPrefix}-tooltip-btn`);
    const tooltipPopover = document.getElementById(`${idPrefix}-tooltip-popover`);

    const presetTag = document.getElementById(`${idPrefix}-preset-tag`);
