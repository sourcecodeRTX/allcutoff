<script define:vars={{ idPrefix, presets: NEGATIVE_MARKING_PRESETS }}>
  (function initNegativeMarkingWidget() {
    const totalQInput = document.getElementById(`${idPrefix}-total-questions`);
    const maxMarksInput = document.getElementById(`${idPrefix}-max-marks`);
    const attemptedInput = document.getElementById(`${idPrefix}-attempted`);
    const wrongInput = document.getElementById(`${idPrefix}-wrong`);
