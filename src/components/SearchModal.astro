---
import { CALCULATORS } from '../data/calculators';

/**
 * Search vocabulary per calculator, in two tiers.
 *
 * `identityTokens` are the tokens that unambiguously *are* this exam or the
 * course it primarily serves. They outrank every other field, so typing
 * "agriculture" lands on TNAU even though EAPCET also mentions the word in its
 * target-course list.
 *
 * `searchAliases` is the wider net: board names, vernacular spellings,
 * alternative codes and secondary courses. These rank below the calculator's
 * short name and its identity tokens.
 *
 * Composed here rather than in `data/calculators.ts` so the registry stays
 * purely about formulas.
 */
const IDENTITY_TOKENS: Record<string, string[]> = {
  'tnea-engineering': ['tnea', 'anna university'],
  'kcet-engineering': ['kcet', 'kea'],
  'neet-ug-medical': ['neet', 'mbbs', 'bds', 'medical'],
  'ap-ts-eapcet': ['eapcet'],
  'tnau-agriculture': ['tnau', 'agriculture', 'agri'],
  'keam-engineering': ['keam'],
  'gujcet-acpc': ['gujcet', 'acpc'],
  'mht-cet-engineering': ['mht cet', 'mhcet'],
  'cuet-du-admission': ['du', 'cuet'],
  'tn-paramedical': ['paramedical', 'b.pharm'],
  'tanuvas-veterinary': ['tanuvas', 'bvsc', 'veterinary'],
  'tngasa-arts-science': ['tngasa', 'bca', 'b.com']
};

const SEARCH_ALIASES: Record<string, string[]> = {
  'tnea-engineering': ['tn 12th', 'tn12', 'anna university', 'b.e', 'b.tech', 'btech', 'do te', 'dote', 'engineering tamil nadu'],
  'kcet-engineering': ['2nd puc', 'puc', 'karnataka common entrance', 'karnataka engineering'],
  'neet-ug-medical': ['neet ug', 'ayush', 'medical', 'nta medical', 'national eligibility'],
  'ap-ts-eapcet': ['ap eapcet', 'ts eapcet', 'apsche', 'tgche', 'ap', 'ts', 'intermediate', 'inter', 'andhra', 'telangana', 'pharmacy'],
  'tnau-agriculture': ['b.sc agriculture', 'horticulture', 'tamilnadu agriculture', 'forestry'],
  'keam-engineering': ['kerala', 'cee kerala', 'kerala engineering', 'nata'],
  'gujcet-acpc': ['gseb', 'gujarat', 'gujarat engineering', 'pharmacy'],
  'mht-cet-engineering': ['maharashtra', 'cap', 'hsc', 'state cet cell'],
  'cuet-du-admission': ['du csas', 'b.com hons', 'delhi university', 'csas', 'ba hons'],
  'tn-paramedical': ['bpt', 'baslp', 'nursing', 'radiography', 'dme tn', 'allied health'],
  'tanuvas-veterinary': ['madras veterinary', 'a.h'],
  'tngasa-arts-science': ['arts and science', 'collegiate education', 'dce tamil nadu', 'bba']
};

/** Tokenise + de-noise a free-form field for the alias index. */
function tokens(value: string): string[] {
  return String(value || '')
    .toLowerCase()
    .split(/[^a-z0-9.%/+]+/i)
    .map((t) => t.replace(/\.$/, ''))
    .filter((t) => t.length > 1);
}

const searchIndex = CALCULATORS.map((c) => {
  const identity = (IDENTITY_TOKENS[c.id] ?? []).map((t) => t.toLowerCase());
  const aliases = Array.from(
    new Set(
      tokens(`${c.shortName} ${c.exam} ${c.category} ${c.state} ${c.targetCourse} ${c.conductingAuthority}`).concat(
        SEARCH_ALIASES[c.id] ?? []
      )
    )
  );

  return {
    id: c.id,
    slug: c.slug,
    name: c.name,
    shortName: c.shortName,
    category: c.category,
    state: c.state,
    exam: c.exam,
    targetCourse: c.targetCourse,
    authority: c.conductingAuthority,
    identityTokens: identity,
    searchAliases: aliases,
    primary: c.shortName.toLowerCase()
  };
});

const QUICK_FILTERS = [
  { label: 'TNEA (Tamil Nadu)', query: 'tnea' },
  { label: 'KCET (Karnataka)', query: 'kcet' },
  { label: 'NEET UG (Medical)', query: 'neet' },
  { label: 'TNAU (Agriculture)', query: 'tnau' }
];
---

<!-- The overlay itself is the scroll container: the padded wrapper below uses
     `min-h-full`, so it can never be its own scroller. Without this the dialog
     is unreachable below ~500px of viewport height (320x568, landscape phones). -->
<div
  id="search-modal-backdrop"
  class="fixed inset-0 z-50 hidden overflow-y-auto overscroll-contain bg-slate-900/40"
  aria-hidden="true"
  inert
>
  <div class="flex min-h-full items-start justify-center p-4 pt-16 sm:pt-24">
    <div
      id="search-modal-dialog"
      role="dialog"
      aria-modal="true"
      aria-label="Search cutoff calculators"
      class="w-full max-w-xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl"
    >
      <!-- Search Input Bar -->
      <div class="flex items-center border-b border-slate-200 px-4 py-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-slate-500" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>

        <input
          id="search-input"
          type="search"
          aria-controls="search-results"
          aria-label="Search by exam, course or state"
          placeholder="Search by exam (TNEA, KCET, NEET, EAPCET), course, or state..."
          class="ml-3 w-full border-none bg-transparent text-sm text-slate-900 placeholder-slate-500 outline-none"
          autocomplete="off"
        />
        <button
          id="close-search-btn"
          type="button"
          class="ml-2 min-h-8 shrink-0 cursor-pointer rounded-md border border-slate-200 bg-slate-50 px-2 py-1 font-mono text-xs text-slate-600 hover:bg-slate-100"
        >
          ESC
        </button>
      </div>

      <!-- Quick Suggestion Chips -->
      <div class="flex flex-wrap items-center gap-1.5 border-b border-slate-200 bg-slate-50 px-4 py-2.5">
        <span class="text-xs font-medium text-slate-500">Popular:</span>
        {QUICK_FILTERS.map((q) => (
          <button
            type="button"
            class="quick-filter-btn focus-ring rounded-full border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 hover:border-blue-300 hover:bg-blue-50"
            data-quick-query={q.query}
            aria-label={`Search calculators for ${q.label}`}
          >
            {q.label}
          </button>
        ))}
      </div>

      <!-- Search Results: a plain results list of links. Not a listbox — these
           rows navigate to pages, so there is nothing for an option to select. -->
      <ul id="search-results" aria-label="Cutoff calculator results" class="overflow-y-auto p-2">
        <!-- Results injected dynamically via JS -->
      </ul>

      <!-- Footer Info -->
      <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-200 bg-slate-50 px-4 py-2 text-xs text-slate-600">
        <span>
          Navigate with
          <kbd class="rounded border border-slate-200 bg-white px-1 font-mono">↑</kbd>
          <kbd class="rounded border border-slate-200 bg-white px-1 font-mono">↓</kbd>
        </span>
        <span>
          Select with
          <kbd class="rounded border border-slate-200 bg-white px-1 font-mono">Enter</kbd>
        </span>
        <span>Esc closes</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* Short viewports: cap the list so the input bar, chips, footer and ESC stay
     on screen. 12rem ≈ the fixed chrome around the list plus the overlay
     padding. The `dvh` cap is behind @supports because Safari < 15.4 cannot
     parse `dvh` and drops the whole declaration — the unconditional `vh` cap
     below is its fallback. */
  #search-results {
    max-height: min(70vh, calc(100vh - 12rem));
  }

  @supports (height: 100dvh) {
    #search-results {
      max-height: min(70dvh, calc(100dvh - 12rem));
    }
  }
</style>

<script define:vars={{ searchIndex }}>
  (function () {
    'use strict';

    var backdrop = document.getElementById('search-modal-backdrop');
    var dialog = document.getElementById('search-modal-dialog');
    var searchInput = document.getElementById('search-input');
    var searchResults = document.getElementById('search-results');
    var closeBtn = document.getElementById('close-search-btn');
    var searchBtn = document.getElementById('search-btn');
    var quickBtns = document.querySelectorAll('.quick-filter-btn');

    if (!backdrop || !dialog || !searchInput || !searchResults) return;

    /* `true` when the live hero widget exists on this page. */
    var hasHeroCalculator = !!document.getElementById('hero-calculator');
    var lastFocused = null;
    var currentResults = [];

    /* Duplicated pending a shared module: the same helper exists in
       HeroCalculator.astro (esc) and CalculatorWidget.astro (esc). Keep all
       three complete — a missing quote escape is a latent injection. */
    function escapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    /* ------------------------------------------------------------------ *
     * Ranking
     * ------------------------------------------------------------------ */

    /**
     * Field weights. Higher wins. Tier order is deliberate:
     *   exact identity token (an exam code or its headline course)
     *     > exact alias / short name
     *       > prefix match anywhere
     *         > incidental substring (state, category, course, authority)
     *
     * Every query token must produce a hit in at least one field, so a
     * multi-word query narrows rather than widens.
     */
    var W = {
      identityExact: 520,
      aliasExact: 400,
      primaryExact: 380,
      primaryPrefix: 300,
      identityPrefix: 280,
      aliasPrefix: 220,
      identityPartial: 180,
      aliasPartial: 120,
      namePrefix: 90,
      namePartial: 60
    };

    /** Highest weight earned by `token` across one field group. */
    function bestFor(values, token, exact, prefix, partial) {
      var best = 0;
      for (var i = 0; i < values.length; i += 1) {
        var value = values[i];
        if (value === token) best = Math.max(best, exact);
        else if (value.indexOf(token) === 0) best = Math.max(best, prefix);
        else if (value.indexOf(token) !== -1) best = Math.max(best, partial);
      }
      return best;
    }

    function scoreItem(item, query, tokens) {
      if (!tokens.length) return 1;

      var primary = item.primary;
      var name = item.name.toLowerCase();
      var identity = item.identityTokens || [];
      var aliases = item.searchAliases;

      // A literal, complete match on an identity token or a short name is
      // treated as "the user asked for this calculator by name".
      if (primary === query || identity.indexOf(query) !== -1) return 2000;
      if (aliases.indexOf(query) !== -1) return 1500;

      var total = 0;

      for (var i = 0; i < tokens.length; i += 1) {
        var token = tokens[i];
        var best = 0;

        best = Math.max(best, bestFor(identity, token, W.identityExact, W.identityPrefix, W.identityPartial));
        best = Math.max(best, bestFor(aliases, token, W.aliasExact, W.aliasPrefix, W.aliasPartial));
        best = Math.max(best, bestFor([primary], token, W.primaryExact, W.primaryPrefix, W.aliasPartial));
        best = Math.max(best, bestFor([name], token, W.aliasExact, W.namePrefix, W.namePartial));

        if (best === 0) return 0;
        total += best;
      }

      // Normalise by token count so a two-word state query does not outrank a
      // one-word exam code.
      return total / tokens.length;
    }

    function runSearch(query) {
      var q = (query || '').toLowerCase().trim();
      var tokens = q.split(/[^a-z0-9.%/+]+/i).filter(function (t) {
        return t.length > 0 && t.length > 1;
      });

      var scored = [];

      searchIndex.forEach(function (item) {
        var score = scoreItem(item, q, tokens);
        if (score > 0) scored.push({ item: item, score: score });
      });

      scored.sort(function (a, b) {
        if (b.score !== a.score) return b.score - a.score;
        return a.item.name.localeCompare(b.item.name);
      });

      return scored.map(function (entry) {
        return entry.item;
      });
    }

    /* ------------------------------------------------------------------ *
     * Rendering.
     * ------------------------------------------------------------------ */
    function resultMarkup(item) {
      var href = '/calculator/' + encodeURIComponent(item.slug);

      var secondaryLabel = hasHeroCalculator ? 'Load in Hero Calculator' : 'Use on home calculator';
      var secondaryHref = '/?calc=' + encodeURIComponent(item.id);

      // One anchor owns the row's title and description, so "clicked the link"
      // and "clicked the text" are the same action with no delegated guesswork.
      // The hero shortcut is a separate sibling link — an anchor may not contain
      // interactive descendants, which is also what ruled out the old
      // role="option" wrapper.
      return (
        '<li class="rounded-xl border border-transparent p-2.5 transition-colors hover:border-slate-200 hover:bg-slate-50">' +
        '<a href="' + href + '" data-search-open class="block rounded-lg">' +
        '<span class="flex flex-wrap items-start justify-between gap-2">' +
        '<span class="min-w-0">' +
        '<span class="block text-sm font-semibold text-slate-900">' + escapeHtml(item.name) + '</span>' +
        '<span class="mt-0.5 block text-xs text-slate-600">' + escapeHtml(item.targetCourse) + ' &bull; ' + escapeHtml(item.state) + '</span>' +
        '<span class="mt-0.5 block text-xs text-slate-500">' + escapeHtml(item.category) + ' &bull; ' + escapeHtml(item.authority) + '</span>' +
        '</span>' +
        '<span class="shrink-0 rounded-md bg-slate-100 px-1.5 py-0.5 font-mono text-xs text-slate-600">' + escapeHtml(item.state) + '</span>' +
        '</span>' +
        '</a>' +
        '<span class="mt-2.5 flex flex-wrap gap-2">' +
        '<a href="' + href + '" class="btn-accent focus-ring min-h-9 px-3 py-1.5 text-xs">Open full page</a>' +
        '<a href="' + secondaryHref + '" data-search-load data-calc-id="' + escapeHtml(item.id) +
        '" class="btn-ghost-soft focus-ring min-h-9 px-3 py-1.5 text-xs">' + escapeHtml(secondaryLabel) + '</a>' +
        '</span>' +
        '</li>'
      );
    }

    function renderResults(query) {
      currentResults = runSearch(query);

      if (currentResults.length === 0) {
        searchResults.innerHTML =
          '<li class="p-6 text-center">' +
          '<p class="text-sm font-semibold text-slate-900">No calculators found for &ldquo;' + escapeHtml(query) + '&rdquo;</p>' +
          '<p class="mt-1 text-xs text-slate-600">Try TNEA, KCET, NEET, B.Pharm, Agriculture, or a state name like Tamil Nadu.</p>' +
          '</li>';
        return;
      }

      searchResults.innerHTML = currentResults.map(resultMarkup).join('');
    }

    /* ------------------------------------------------------------------ *
     * Keyboard: real focus on the result links (no synthetic active option).
     * ------------------------------------------------------------------ */
    function rowLinks() {
      return Array.prototype.slice.call(searchResults.querySelectorAll('[data-search-open]'));
    }

    /** Move focus through the result rows; wraps at both ends. */
    function moveFocus(step) {
      var links = rowLinks();
      if (!links.length) return false;

      var from = links.indexOf(document.activeElement);
      var next = from < 0 ? (step > 0 ? 0 : links.length - 1) : (from + step + links.length) % links.length;
      var target = links[next];
      if (!target || typeof target.focus !== 'function') return false;

      target.focus();
      if (typeof target.scrollIntoView === 'function') {
        target.scrollIntoView({ block: 'nearest' });
      }
      return true;
    }

    function focusableInDialog() {
      return Array.prototype.slice
        .call(dialog.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'))
        .filter(function (el) {
          return el.offsetParent !== null || el === document.activeElement;
        });
    }

    /* ------------------------------------------------------------------ *
     * Actions.
     * ------------------------------------------------------------------ */
    function loadCalculator(id) {
      if (!id) return;

      if (hasHeroCalculator) {
        // Close first: the page behind is scroll-locked and inert while the
        // modal is open, so the hero's scrollIntoView would be a no-op.
        closeSearch();
        window.dispatchEvent(
          new CustomEvent('allcutoff:load-calculator', { detail: { id: id } })
        );
        return;
      }

      window.location.href = '/?calc=' + encodeURIComponent(id);
    }

    searchResults.addEventListener('click', function (event) {
      var loadLink = event.target.closest('[data-search-load]');
      if (loadLink) {
        event.preventDefault();
        loadCalculator(loadLink.getAttribute('data-calc-id'));
      }
      // Plain `<a>` rows navigate natively — no delegated href assignment and
      // no "the description text was outside the link" ambiguity.
    });

    /* ------------------------------------------------------------------ *
     * Page isolation + open / close + focus management.
     * ------------------------------------------------------------------ */
    var bodyLock = { overflow: '', paddingRight: '' };

    /** Lock the page behind the modal, compensating for the scrollbar so the
        layout does not jump sideways. Every touch is defensive. */
    function lockPage() {
      var body = document.body;
      if (!body) return;
      try {
        bodyLock = { overflow: body.style.overflow, paddingRight: body.style.paddingRight };
        var gap = window.innerWidth - document.documentElement.clientWidth;
        if (gap > 0) {
          var current = parseInt(window.getComputedStyle(body).paddingRight, 10) || 0;
          body.style.paddingRight = current + gap + 'px';
        }
        body.style.overflow = 'hidden';
      } catch (err) {
        /* Locking is cosmetic; never let it block the dialog. */
      }
    }

    function unlockPage() {
      var body = document.body;
      if (!body) return;
      try {
        body.style.overflow = bodyLock.overflow;
        body.style.paddingRight = bodyLock.paddingRight;
      } catch (err) {
        /* Nothing to restore. */
      }
    }

    /** Make the page behind the dialog unreachable by pointer and keyboard. */
    function setBackgroundInert(on) {
      var regions = document.querySelectorAll('body > main, body > footer');
      Array.prototype.forEach.call(regions, function (el) {
        try {
          el.toggleAttribute('inert', on);
          // Older engines without `inert` still need the AT-only isolation.
          el.setAttribute('aria-hidden', on ? 'true' : 'false');
        } catch (err) {
          /* Ignore a region we cannot mark. */
        }
      });
    }

    function openSearch() {
      lastFocused = document.activeElement;
      backdrop.classList.remove('hidden');
      backdrop.removeAttribute('inert');
      backdrop.setAttribute('aria-hidden', 'false');
      renderResults(searchInput.value);
      searchInput.focus();
      var len = searchInput.value.length;
      try {
        searchInput.setSelectionRange(len, len);
      } catch (err) {
        /* Some input types disallow the selection APIs. */
      }
      // Focus is inside the dialog before the page behind it is hidden from AT.
      lockPage();
      setBackgroundInert(true);
    }

    function closeSearch() {
      backdrop.classList.add('hidden');
      backdrop.setAttribute('inert', '');
      backdrop.setAttribute('aria-hidden', 'true');
      searchInput.value = '';
      setBackgroundInert(false);
      unlockPage();
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus();
      }
      lastFocused = null;
    }

    if (searchBtn) searchBtn.addEventListener('click', function () { openSearch(); });
    if (closeBtn) closeBtn.addEventListener('click', function () { closeSearch(); });

    backdrop.addEventListener('mousedown', function (event) {
      // The padded wrapper fills the overlay, so test for "outside the dialog"
      // rather than for the overlay element itself.
      if (event.target === backdrop || !event.target.closest('#search-modal-dialog')) closeSearch();
    });

    quickBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var query = btn.getAttribute('data-quick-query') || (btn.textContent || '').split(' ')[0];
        searchInput.value = query;
        renderResults(query);
        searchInput.focus();
      });
    });

    searchInput.addEventListener('input', function (event) {
      renderResults(event.target.value);
    });

    /* Arrow keys move real focus into and through the result rows; Enter then
       activates the focused link natively. */
    function handleResultKeys(event) {
      var step = 0;
      if (event.key === 'ArrowDown' || event.key === 'ArrowRight') step = 1;
      else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') step = -1;
      else if (event.key === 'Home' || event.key === 'End') {
        var links = rowLinks();
        if (links.length) {
          event.preventDefault();
          (event.key === 'Home' ? links[0] : links[links.length - 1]).focus();
        }
        return;
      } else {
        return;
      }

      if (moveFocus(step)) event.preventDefault();
    }

    searchInput.addEventListener('keydown', function (event) {
      // Enter in the field opens the top hit, matching the "Select with Enter"
      // hint in the dialog footer.
      if (event.key === 'Enter') {
        var top = rowLinks()[0];
        if (top) {
          event.preventDefault();
          window.location.href = top.getAttribute('href');
        }
        return;
      }
      handleResultKeys(event);
    });
    searchResults.addEventListener('keydown', handleResultKeys);

    window.addEventListener('keydown', function (event) {
      var isOpen = !backdrop.classList.contains('hidden');

      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (isOpen) closeSearch();
        else openSearch();
        return;
      }

      if (!isOpen) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        closeSearch();
        return;
      }

      if (event.key === 'Tab') {
        // Focus trap for the whole dialog subtree, not just the input: without
        // this, Tab from the ESC button or a result link walks into the page
        // behind the aria-modal overlay.
        var focusable = focusableInDialog();
        if (!focusable.length) return;
        var first = focusable[0];
        var last = focusable[focusable.length - 1];
        var inside = dialog.contains(document.activeElement);

        if (!inside) {
          event.preventDefault();
          (event.shiftKey ? last : first).focus();
        } else if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>