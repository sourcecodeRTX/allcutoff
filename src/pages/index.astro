          <dl class="mt-4 flex flex-wrap">
            {ex.rows.map((row) => (
              <div class="surface-dashed-card w-1/2 flex-1 basis-[9rem] px-3.5 py-2.5 not-first:ml-2 first:ml-0">
                <dt class="font-mono text-[0.75rem] uppercase tracking-wider text-slate-500">{row.label}</dt>
