---
import Layout, { SITE_URL, clampDescription, pickDescription } from '../layouts/Layout.astro';
import CalculatorCard from '../components/CalculatorCard.astro';
import HeroCalculator from '../components/HeroCalculator.astro';
import { ACADEMIC_YEAR, CALCULATORS, CATEGORIES, STATES } from '../data/calculators';

const SITE = SITE_URL;
const canonical = `${SITE}/`;

/** Real content-review date for the home page. Never the build clock. */
const HOME_REVIEWED = '2026-10-06';

/**
 * Single source of truth for the academic year: read it off the registry rather
 * than hardcoding "2025 - 2026" again, so the badge, the FAQ and every meta tag
 * move together when the cycle rolls over.
 */
const YEAR = CALCULATORS[0]?.academicYear ?? ACADEMIC_YEAR;
const YEAR_LABEL = YEAR.replace(/\s*-\s*/g, '-');
/** Display form with an en dash, e.g. "2025–2026". */
const YEAR_DISPLAY = YEAR.replace(/\s*-\s*/g, '\u2013');

/**
 * The H1 used to hardcode "& 9 More Entrance Exams", which implied thirteen
 * calculators on a page whose own counter and `ItemList.numberOfItems` both say
 * twelve. The named exams are filtered against the registry and the remainder is
 * derived from `CALCULATORS.length`, so the headline can never drift from the
 * grid below it again.
 */
const HEADLINE_EXAMS = ['TNEA', 'KCET', 'NEET UG', 'EAPCET'];
const namedExams = HEADLINE_EXAMS.filter((code) =>
  CALCULATORS.some((c) => `${c.shortName} ${c.exam}`.toUpperCase().includes(code))
);
const unnamedCount = Math.max(0, CALCULATORS.length - namedExams.length);
const heroHeadline =
  `Cut Off Calculator for ${namedExams.join(', ')}` +
  (unnamedCount > 0 ? ` & ${unnamedCount} More Entrance Exams` : '');

/*
 * Hero stat strip counts. `AUTHORITY_COUNT` counts DISTINCT conducting bodies,
 * not calculators: several bodies run more than one exam, and quoting "12
 * authorities" would be a false claim on the most credibility-sensitive part of
 * the page. Both numbers are derived so they track the registry automatically.
 */
const AUTHORITY_COUNT = new Set(CALCULATORS.map((c) => c.conductingAuthority)).size;
const STATE_COUNT = STATES.length;

/**
 * Keyword map: every supporting phrase the brief asks for, bound to the one
 * page that actually answers it. Rendered as a visible chooser (so it is real
 * navigation for a reader, not a stuffed block of text) and reused by the
 * in-page jump nav, which is why each entry carries its own `href`.
 */
type FinderCard = { term: string; title: string; body: string; href: string; tag: string };

const url = (id: string): string => {
  const hit = CALCULATORS.find((c) => c.id === id);
  return hit ? `/calculator/${hit.slug}` : '/#calculators';
};

const FIND_YOUR_CALCULATOR: FinderCard[] = [
  {
    tag: 'Most used',
    term: 'cut off calculator',
    title: 'Cut off calculator for every Indian entrance exam',
    body:
      'The starting point. Pick the exam you actually sat, enter the marks exactly as your scorecard prints them, and the tool applies that authority’s published weighting — nothing averaged, nothing guessed.',
    href: '/#calculators'
  },
  {
    tag: 'Engineering',
    term: 'cut off calculator for engineering',
    title: 'Engineering cut off calculator for every state',
    body:
      'Covers TNEA, MHT CET, KCET, KEAM, GUJCET and EAPCET engineering seats. Each state weights Mathematics, Physics and Chemistry differently, so the same three marks produce six different merit scores. Search for an engineering cut off calculator by your state, not by a generic formula.',
    href: '/category/engineering'
  },
  {
    tag: 'Tamil Nadu',
    term: 'tnea cut off calculator',
    title: 'TNEA engineering cut off calculator',
    body:
      'The Anna University 200-mark formula: Mathematics in full, Physics and Chemistry halved. Also the fastest way to see why a Tamil Nadu engineering aspirant cannot ignore Maths.',
    href: url('tnea-engineering')
  },
  {
    tag: '12th board',
    term: '12th cut off calculator',
    title: '12th cut off calculator for board marks',
    body:
      'Turns your Class 12 PCM or PCB percentages into the merit score your state actually ranks on. If you searched for a 12 cut off calculator, read this first: the answer depends entirely on the state you are applying in, and each authority weights your 12th marks differently.',
    href: '/#twelfth-board'
  },
  {
    tag: '12th marks',
    term: '12th mark cut off calculator',
    title: '12th mark cut off calculator with worked examples',
    body:
      'A step-by-step version with real numbers — 88, 76 and 81 in PCM carried all the way through the TNEA, KCET and EAPCET formulas so you can check the arithmetic line by line.',
    href: '/#twelfth-board'
  },
  {
    tag: 'Medical',
    term: 'medical cut off calculator',
    title: 'Medical cut off calculator for NEET UG',
    body:
      'Totals Physics, Chemistry and Biology out of 720 and checks the published qualifying-percentile band for your category, which is where most NEET score myths come from. A medical cut off calculator is also the fastest sanity check on a coaching institute’s number.',
    href: url('neet-ug-medical')
  },
  {
    tag: 'Biology',
    term: 'biology cut off calculator',
    title: 'Biology cut off calculator for paramedical and veterinary',
    body:
      'A biology cut off calculator is the right tool for courses where Biology carries real weight: Tamil Nadu paramedical and TANUVAS veterinary both score Biology at 100 of 200, against NEET UG where Biology is 360 of 720. A biology cut off calculator will not help an engineering seat at all, because those formulas ignore Biology entirely.',
    href: url('tn-paramedical')
  },
  {
    tag: 'Tamil Nadu',
    term: 'cut off calculator for medical tamilnadu',
    title: 'Medical cut off calculator for Tamil Nadu',
    body:
      'Tamil Nadu’s paramedical and veterinary merit rules are separate from NEET. Biology at full weight plus the Physics–Chemistry average is the rule both of them use.',
    href: url('tn-paramedical')
  },
  {
    tag: 'Agriculture',
    term: 'cut off calculator for agriculture',
    title: 'Agriculture cut off calculator for TNAU',
    body:
      'B.Sc. (Hons.) Agriculture and allied degrees in Tamil Nadu use a four-subject halved formula out of 200 — Physics, Chemistry, Biology and Maths or Computer Science.',
    href: url('tnau-agriculture')
  },
  {
    tag: 'By state',
    term: 'state level cut off calculator',
    title: 'State level cut off calculators',
    body:
      'Admission arithmetic is decided state by state. This page collects the calculators for Tamil Nadu, Karnataka, Kerala, Gujarat, Maharashtra, Delhi and the AP–TS corridor.',
    href: '/#by-state'
  },
  {
    tag: 'Any exam',
    term: 'online cut off calculator',
    title: 'Online cut off calculator that runs offline',
    body:
      'No account, no OTP, no emailed report and no mark ever leaving your device — the calculation runs in your browser, so it works on a low-end phone or a patchy college network.',
    href: '/#how-it-works'
  },
  {
    tag: 'All exams',
    term: 'cut off calculator for 12th',
    title: 'Cut off calculator for 12th standard students',
    body:
      'One place to see how your 12th percentage is used differently by TNEA, KCET, KEAM, GUJCET, EAPCET and the arts and science route — plus which of them need an entrance score too.',
    href: '/#formula-reference'
  }
];

/* -------------------------------------------------------------------------
 * 12th-board worked examples.
 *
 * Data-driven so the prose and the arithmetic table can never drift apart, and
 * laid out as ONE column: prose at a readable measure, line items as a full
 * width strip underneath. The previous two-column version put prose and an
 * 18rem aside side by side, which squeezed the measure to ~62 characters on a
 * 1440px screen — fine on mobile, unreadable on desktop.
 * ---------------------------------------------------------------------- */
type WorkedExample = {
  exam: string;
  scale: string;
  body: string[];
  equation: string;
  result: string;
  rows: { label: string; value: string }[];
  note: string;
};

const WORKED_EXAMPLES: WorkedExample[] = [
  {
    exam: 'Tamil Nadu engineering (TNEA)',
    scale: '200 marks',
    body: [
      `Tamil Nadu is the simplest formula on this site and the one most people get wrong by halving the wrong subjects. Mathematics is counted in full at 100 marks; Physics and Chemistry are each halved to 50. The reason is that Tamil Nadu admits on academic ability as much as on entrance score, so the subject most predictive of an engineering student&rsquo;s first-year performance keeps its maximum weight. A candidate cannot pass a weak Mathematics mark with a strong Physics score.`,
      `Your aggregate PCM percentage is checked separately. Below 40% you are not eligible at all; between 40% and 45% you are eligible only under the reserved categories in Tamil Nadu (BC, MBC, SC, ST); 45% and above clears the general condition. That gate is an eligibility filter, not part of the 200-mark score, which is why two candidates with identical totals can have different outcomes.`
    ],
    equation: '88 + (76 ÷ 2) + (81 ÷ 2) = 88 + 38 + 40.5',
    result: '166.5 / 200',
    rows: [
      { label: 'Maths', value: '88 / 100' },
      { label: 'Physics ÷ 2', value: '38 / 50' },
      { label: 'Chemistry ÷ 2', value: '40.5 / 50' }
    ],
    note: 'PCM average 81.67% — clears the 45% general eligibility gate.'
  },
  {
    exam: 'Karnataka engineering (KCET)',
    scale: '100 marks',
    body: [
      `Karnataka splits the weight exactly in half between your 12th board PCM total and your KCET entrance score. Your board marks are converted to a percentage out of 100 and then scaled to 50 marks; your entrance score out of 180 is scaled to 50 marks; the two are added. This structure was the point of the 2018 Karnataka High Court ruling that ended board-mark-only ranking, and it is why the same candidate who scored 166.5 in TNEA cannot simply carry that number into KCET.`,
      `Assume the same student scored 118 out of 180 in the KCET entrance paper. Board PCM total is 88 + 76 + 81 = 245 out of 300, which is 81.67%. Scaled to 50 that is 40.83. The entrance score scaled to 50 is 32.78. Karnataka also requires a board aggregate of at least 45% for the general category and 40% for reserved categories, so the gate is checked here as well.`
    ],
    equation: '(245 ÷ 300 × 50) + (118 ÷ 180 × 50) = 40.83 + 32.78',
    result: '73.61 / 100',
    rows: [
      { label: 'Board PCM', value: '245 / 300' },
      { label: 'Board → 50', value: '40.83 / 50' },
      { label: 'KCET → 50', value: '32.78 / 50' }
    ],
    note: 'The board half contributed 40.83 of the 73.61 composite and the entrance half 32.78. Each is capped at 50, so neither half can be ignored — which is the whole point of a 50:50 rule.'
  },
  {
    exam: 'Andhra Pradesh & Telangana (EAPCET)',
    scale: '100 marks',
    body: [
      `EAPCET is the most entrance-weighted rule on this site: the 160-mark entrance paper carries 75% of the composite and the Intermediate group percentage carries 25%. A 160-mark paper is unusual in scale, which is where most hand calculations go wrong — candidates divide by 200 out of habit and end up with a score roughly a fifth too low. Telangana has in recent sessions waived the Intermediate component, so check the current brochure before relying on the 25% figure.`,
      `There is also a hard qualifying floor that has nothing to do with the composite: OC and BC candidates must score at least 40 out of 160, which is 25%. Below that, the composite is irrelevant because the candidate is not ranked at all. SC and ST candidates are exempt from the minimum. With an entrance score of 96 and an Intermediate group percentage of 81:`
    ],
    equation: '(96 ÷ 160 × 75) + (81 ÷ 100 × 25) = 45 + 20.25',
    result: '65.25 / 100',
    rows: [
      { label: 'Entrance raw', value: '96 / 160' },
      { label: 'Entrance × 75%', value: '45.00 / 75' },
      { label: 'Inter × 25%', value: '20.25 / 25' }
    ],
    note: 'Qualifying floor for OC and BC candidates: 40 out of 160. A score of 96 clears it comfortably.'
  },
  {
    exam: 'Kerala engineering (KEAM)',
    scale: '600 index marks',
    body: [
      `Kerala produces an index out of 600 rather than a percentage, and the board component is split 5:3:2 across Mathematics, Physics and Chemistry — the same 3:2:1 family you meet in CBSE PCM. The entrance paper out of 600 is scaled to 300, and the three board subjects are scaled to 150, 90 and 60 respectively, so the board half also totals 300. Kerala additionally normalises board marks across regions and boards before this arithmetic, which is a statistical step only the CEE can perform; use the published standardised percentage, never a raw total.`,
      `With an entrance score of 410 out of 600 and board marks of 88, 76 and 81, the index works out as follows. A minimum normalised entrance score of 10 is required just to enter the engineering rank list. It is a low bar that catches only blank or near-blank papers, but it is absolute: no index mark counts without it.`
    ],
    equation: '(410 ÷ 600 × 300) + (88 × 1.5) + (76 × 0.9) + (81 × 0.6)',
    result: '454 / 600',
    rows: [
      { label: 'Entrance', value: '205 / 300' },
      { label: 'Maths × 1.5', value: '132 / 150' },
      { label: 'Physics × 0.9', value: '68.4 / 90' },
      { label: 'Chemistry × 0.6', value: '48.6 / 60' }
    ],
    note: '205 + 132 + 68.4 + 48.6 = 454. Entrance 410 clears the minimum normalised score of 10 comfortably.'
  }
];

const pageTitle = 'Cut Off Calculator for TNEA, KCET & NEET UG';
const pageDesc = clampDescription(
  pickDescription([
    `Free cut off calculator for TNEA, KCET, NEET UG, EAPCET, TNAU, KEAM, GUJCET and 12th board marks. Get your official weighted merit score instantly, no signup.`,
    `Free cut off calculator for TNEA, KCET, NEET UG, EAPCET, TNAU, KEAM, GUJCET and 12th board marks. Get your official merit score instantly.`,
    `Free online cut off calculator for TNEA, KCET, NEET UG, EAPCET, MHT CET and 12th board marks. Instant weighted merit score, no signup.`
  ])
);

/* -------------------------------------------------------------------------
 * Homepage FAQ — single source of truth for the visible accordion and the
 * FAQPage JSON-LD node, so schema and on-page copy can never drift apart.
 * ---------------------------------------------------------------------- */
const HOME_FAQS = [
  {
    question: `Are these cutoff calculators updated for the ${YEAR_LABEL} admission season?`,
    answer:
      'Yes. Every formula on All Cut Off is transcribed from the admission brochure, information bulletin or official notification of the conducting body for the current cycle — DoTE Tamil Nadu, KEA Karnataka, APSCHE and TGCHE, ACPC Gujarat, CEE Kerala, the Maharashtra CET Cell, TNAU, TANUVAS, DCE Tamil Nadu, the NTA and the University of Delhi. When a body amends its merit rule, the calculator is updated rather than silently kept.'
  },
  {
    question: 'Do I need to sign up, log in, or enter my phone number?',
    answer:
      'No. All Cut Off has no accounts and no paywall. There is no registration, no OTP, and no email capture. Every calculation runs entirely inside your browser, so the marks you type are never transmitted to our servers or stored anywhere.'
  },
  {
    question: 'What exactly is a cutoff score, and how is it different from my admission rank?',
    answer:
      'A cutoff score is the raw or composite mark that your counselling authority computes from your board and entrance results, such as 184 out of 200 in TNEA or 82.5 out of 100 in KCET. A rank is your position in the merit list after every candidate with a similar score has been separated by the published tie-breaking rules and after category reservation is applied. A cutoff score tells you what to expect; only the published merit list tells you where you actually landed.'
  },
  {
    question: 'Can CBSE or ICSE students use the state board cutoff calculators?',
    answer:
      'Yes, with one rule in mind: these calculators expect each subject mark out of 100, which is what both CBSE and ICSE print for most subjects. If your board evaluates a subject out of 50 or 200, convert it to a percentage out of 100 first. Board-level normalisation used by states such as Kerala is a statistical process that only the conducting authority can apply, so enter your published standardised PCM percentage there rather than a raw total.'
  },
  {
    question: 'Why does the same calculator give a different number from my college website?',
    answer:
      'Usually one of three things. First, the college may be quoting the previous year closing mark, not the live calculated merit score — those are different numbers. Second, some portals add a bonus or a normalisation step we cannot reproduce without the full normalised marks. Third, a genuine formula change in a new brochure. Send the brochure reference and the marks you used to our contact page and we will check and correct the calculator.'
  },
  {
    question: 'Is the result guaranteed admission?',
    answer:
      'No, and we will not pretend otherwise. A calculator reproduces the published arithmetic, which is the part most students get wrong by hand. Seat availability, category reservation, choice freezing, tie-breakers on identical scores, and the order of rounds all sit above that arithmetic and are decided by the conducting authority. Always treat our number as your merit score and the official counselling portal as the decision.'
  },
  {
    question: 'What is a cut off calculator, in plain words?',
    answer:
      'A cut off calculator converts the marks printed on your 12th board scorecard and your entrance scorecard into the single merit number your counselling authority ranks on. For most engineering seats that number is not your percentage and not your entrance rank — it is a weighted figure produced by a formula the state publishes, such as Maths in full plus Physics and Chemistry halved for TNEA, or a 50:50 board-plus-exam composite for KCET. The calculator applies that formula exactly, so your score can be checked by hand.'
  },
  {
    question: 'How do I calculate my cut off from 12th board marks?',
    answer:
      'It depends on the state. In Tamil Nadu engineering, add your Mathematics mark to half your Physics mark plus half your Chemistry mark: 88 Maths, 76 Physics and 81 Chemistry gives 88 + 38 + 40.5 = 166.5 out of 200. In Karnataka, your 12th PCM total out of 300 is scaled to 50 marks and added to your KCET score scaled to 50, so board marks alone never decide the rank. In Kerala the 12th marks enter on a 5:3:2 ratio for Maths, Physics and Chemistry alongside the entrance score. This page has the worked arithmetic for each.'
  },
  {
    question: 'My 12th board marks are out of 200 for one subject. What do I enter?',
    answer:
      'Convert to a percentage out of 100 before entering it, because every calculator here reads each subject on a 100-point scale. A subject score of 184 out of 200 becomes 92, and 162 out of 200 becomes 81. If your board prints a CGPA instead of marks, multiply it by 10 — a 9.2 CGPA is 92%. Where a state applies its own statistical normalisation, such as Kerala, use the standardised figure published by the conducting authority, because a raw total will not match their index.'
  },
  {
    question: 'What is the difference between a cut off score, a closing mark and a qualifying mark?',
    answer:
      'A qualifying mark is the minimum you must score just to appear in the merit list, such as 50% of HSC PCM marks for MHT CET or the 40 marks out of 160 that OC and BC candidates need in EAPCET. A cut off score is your own weighted merit figure. A closing mark is the last score at which a seat was actually filled in the previous round, which is a historical outcome rather than a rule. Your calculator produces the middle number; the other two decide whether you get called.'
  },
  {
    question: 'Do these calculators work for CBSE, ICSE and other boards?',
    answer:
      'Yes. The formulas are published by the admitting authority, not by your Class 12 board, so a CBSE candidate sitting TNEA and a Tamil Nadu board candidate sitting TNEA are ranked on identical arithmetic. The only requirement is that you enter each subject as a mark out of 100. Students of other boards that print subject totals out of 50 or out of 200 should convert to a percentage first, and students with a CGPA should multiply by 10.'
  },
  {
    question: 'Can I use one cut off calculator for every state?',
    answer:
      'No, and using one is the single most common reason a student misreads their own merit list. Tamil Nadu halves Physics and Chemistry; Karnataka splits the weight equally between board and entrance; Andhra Pradesh and Telangana weight the entrance at 75% against 25% of Intermediate marks; Kerala uses a 5:3:2 subject ratio with a scaled entrance score; Gujarat uses 60:40 board theory against the entrance. Each of those is on this site as its own calculator, because they genuinely produce different numbers from the same marks.'
  },
  {
    question: 'Why does my calculator score not match the cutoff quoted by a coaching institute?',
    answer:
      'Almost always because two different numbers are being compared. Institutes usually quote a previous year’s closing mark, which is a historical figure decided by seat availability and category reservation, while a calculator produces the live merit score from your own marks. A second cause is a coaching formula that drops an eligibility gate, such as the HSC percentage condition in MHT CET or the minimum normalised entrance score in KEAM, which changes the label but not the score. Check both numbers on the same scale before concluding either one is wrong.'
  },
  {
    question: 'Is my data safe? Do you store my marks?',
    answer:
      'There is nothing to store, because there are no accounts on this site. Every formula is executed client-side in your own browser, the marks you type never travel to a server, and we hold no register, no login and no contact list. That also means the tools keep working on a slow connection or completely offline once the page has loaded.'
  }
];

/* -------------------------------------------------------------------------
 * Exam comparison table data (max score + the one weighting rule that matters).
 * ---------------------------------------------------------------------- */
const WEIGHTING_RULE: Record<string, string> = {
  'tnea-engineering': 'Maths at 100%; Physics and Chemistry halved',
  'tnau-agriculture': 'All four core subjects halved to 50 each',
  'kcet-engineering': '50% 12th Board PCM + 50% KCET entrance',
  'ap-ts-eapcet': '75% EAPCET (of 160) + 25% Intermediate group %',
  'tn-paramedical': 'Biology at 100% + (Physics + Chemistry) / 2',
  'tanuvas-veterinary': 'Biology at 100% + (Physics + Chemistry) / 2',
  'keam-engineering': '50:50 index — entrance scaled to 300 + board PCM scaled to 300',
  'gujcet-acpc': '50% Board PCM theory + 50% GUJCET (theory only)',
  'neet-ug-medical': 'Straight total of the 720 raw marks; percentile decides merit',
  'cuet-du-admission': 'Sum of mapped CUET subjects (800, or 600 for B.Sc)',
  'mht-cet-engineering': 'Maths 100 + Physics 50 + Chemistry 50; HSC is an eligibility gate',
  'tngasa-arts-science': 'Four core subjects summed to 400; language papers excluded'
};

const comparisonRows = [
  ...CALCULATORS.map((c) => ({
    id: c.id,
    exam: c.shortName,
    authority: c.conductingAuthority,
    max: c.maxScore,
    unit: c.scoreUnit,
    rule: WEIGHTING_RULE[c.id] ?? 'See official brochure',
    slug: c.slug
  })),
  {
    id: 'custom-general',
    exam: 'Custom / General % Mode',
    authority: 'No authority — your own target',
    max: 100,
    unit: '%',
    rule: 'No weighting; a straight comparison against a cutoff you type in',
    slug: '#calculators'
  }
];

/* -------------------------------------------------------------------------
 * Hero search index (independent of the global Ctrl+K modal so the homepage
 * dropdown stays instant and does not need a round trip through Layout).
 * ---------------------------------------------------------------------- */
const HERO_ALIASES: Record<string, string[]> = {
  'tnea-engineering': ['tnea', 'anna university', 'b.tech', 'engineering'],
  'kcet-engineering': ['kcet', 'kea', 'karnataka', 'puc'],
  'neet-ug-medical': ['neet', 'mbbs', 'bds', 'medical', 'ayush'],
  'ap-ts-eapcet': ['eapcet', 'apsche', 'tgche', 'andhra', 'telangana', 'b.pharm'],
  'tnau-agriculture': ['tnau', 'agriculture', 'agri'],
  'keam-engineering': ['keam', 'kerala'],
  'gujcet-acpc': ['gujcet', 'acpc', 'gujarat', 'gseb'],
  'mht-cet-engineering': ['mht cet', 'mhcet', 'maharashtra', 'cap'],
  'cuet-du-admission': ['du', 'cuet', 'delhi university', 'bca', 'b.com'],
  'tn-paramedical': ['paramedical', 'b.pharm', 'nursing', 'bpt'],
  'tanuvas-veterinary': ['tanuvas', 'veterinary', 'bvsc'],
  'tngasa-arts-science': ['tngasa', 'arts and science', 'bca', 'b.com']
};

const HERO_CUSTOM_ENTRY = {
  id: 'custom-general',
  slug: 'custom-general',
  name: 'Custom / General % Mode',
  shortName: 'Custom / General %',
  category: 'Custom',
  state: 'Universal',
  targetCourse: 'Compare any score against any target cutoff'
};

const heroSearchIndex = [
  ...CALCULATORS.map((c) => ({
    id: c.id,
    slug: c.slug,
    name: c.name,
    meta: `${c.targetCourse} — ${c.state}`,
    haystack: [
      c.shortName,
      c.exam,
      c.category,
      c.state,
      c.targetCourse,
      c.conductingAuthority,
      ...(HERO_ALIASES[c.id] ?? [])
    ]
      .join(' ')
      .toLowerCase()
  })),
  {
    id: HERO_CUSTOM_ENTRY.id,
    slug: HERO_CUSTOM_ENTRY.slug,
    name: HERO_CUSTOM_ENTRY.name,
    meta: HERO_CUSTOM_ENTRY.targetCourse,
    haystack: 'custom general percentage target compare universal mode %'.toLowerCase()
  }
];

/* -------------------------------------------------------------------------
 * Structured data.
 * ---------------------------------------------------------------------- */
const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE}/#faq`,
  mainEntity: HOME_FAQS.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};

/*
 * No `WebSite` override and no `SearchAction` here. The layout already publishes
 * the single `#website` node, and two nodes sharing one @id silently overwrite
 * each other. Search is client state only — nothing reads `?q=` — and Google
 * retired the sitelinks search box in November 2024, so advertising one was a
 * claim the site cannot honour.
 */

const itemListSchema = {
  '@type': 'ItemList',
  '@id': `${SITE}/#calculator-directory`,
  name: 'Admission cutoff calculators on All Cut Off',
  numberOfItems: CALCULATORS.length,
  itemListElement: CALCULATORS.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    url: `${SITE}/calculator/${c.slug}`
  }))
};

const extraSchema = [faqSchema, itemListSchema];
---

<Layout
  title={pageTitle}
  description={pageDesc}  canonicalUrl={canonical}
  dateModified={HOME_REVIEWED}
  extraSchema={extraSchema}
>
  <!-- ══════════════════════ HERO ══════════════════════ -->
  <!-- No `overflow-hidden`: it was only ever there to clip the old mesh-gradient
       bloom, and global.css has replaced that with a flat `inset-0` wash on the
       glow div itself, which cannot bleed. Leaving it in clipped the search
       dropdown, which is absolutely positioned below the fold of this box. -->
  <section class="relative border-b border-slate-200 bg-slate-50 py-12 sm:py-16 lg:py-20">
    <div class="pointer-events-none absolute inset-0 mesh-gradient-glow opacity-70" aria-hidden="true"></div>

