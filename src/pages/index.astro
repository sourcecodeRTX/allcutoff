<!-- ══════════════════════ DIRECTORY FILTERING ══════════════════════ -->
<script define:vars={{ REFILTER_EVENT: 'allcutoff:refilter-directory' }}>
  function initDirectoryFilters() {
    const categoryBtns = document.querySelectorAll('.category-filter-btn');
    // The hero search box doubles as the directory filter box. It also has its
    // own instant-results dropdown, which is why both listeners live here.
    const searchInput = document.getElementById('hero-search-input');
    const cards = document.querySelectorAll('.calc-card-item');
    const noResultsMsg = document.getElementById('no-results-msg');
    const countDisplay = document.getElementById('calc-count');

    let activeCategory = 'all';

    function filterCards() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      const tokens = query.split(/[^a-z0-9.%/+]+/i).filter((t) => t.length > 1);
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardCategory = card.getAttribute('data-category');
        const haystack = (card.getAttribute('data-search') || card.getAttribute('data-name') || '').toLowerCase();

        // Every token must appear somewhere, so "tamil nadu bca" narrows instead
        // of widening. Empty query matches everything.
        const matchesSearch =
          tokens.length === 0 ||
          tokens.every((token) => haystack.includes(token));

        const matchesCategory = activeCategory === 'all' || cardCategory === activeCategory;

        if (matchesCategory && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countDisplay) countDisplay.textContent = visibleCount.toString();
      if (noResultsMsg) {
        noResultsMsg.classList.toggle('hidden', visibleCount !== 0);
      }
    }

    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeCategory = btn.getAttribute('data-category') || 'all';
        filterCards();
      });
    });

    if (searchInput) searchInput.addEventListener('input', filterCards);

    /*
     * Re-filter hook. The hero search clears or rewrites its own input
     * programmatically when a result is loaded into the hero calculator, and a
     * programmatic assignment fires no `input` event — so the grid used to stay
     * filtered on a stale query and `#calc-count` claimed the site only had one
     * calculator. Anything that changes the box must ask for a re-filter.
     */
    window.addEventListener(REFILTER_EVENT, filterCards);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDirectoryFilters);
  } else {
    initDirectoryFilters();
  }
</script>

<!-- ══════════════════════ HERO INSTANT SEARCH ══════════════════════ -->
<script define:vars={{ heroSearchIndex, CUSTOM_HERO_ID: HERO_CUSTOM_ENTRY.id, REFILTER_EVENT: 'allcutoff:refilter-directory' }}>
  (function () {
    'use strict';

    function escapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function initHeroSearch() {
      var input = document.getElementById('hero-search-input');
      var dropdown = document.getElementById('hero-search-dropdown');
      if (!input || !dropdown) return;

      var results = [];

      function score(entry, query, tokens) {
        if (!tokens.length) return 1;
        if (entry.name.toLowerCase() === query) return 1000;

        var total = 0;
        for (var i = 0; i < tokens.length; i += 1) {
          var token = tokens[i];
          var position = entry.haystack.indexOf(token);
          if (position === -1) return 0;

          // Word-start hits and shorter haystacks rank higher.
          var bonus = position === 0 ? 120 : position < 40 ? 60 : 20;
          bonus -= Math.min(40, entry.haystack.length / 40);
          total += bonus;
        }
        return total / tokens.length;
      }

      function runSearch(query) {
        var q = query.toLowerCase().trim();
        var tokens = q.split(/[^a-z0-9.%/+]+/i).filter(function (t) {
          return t.length > 1;
        });

        var scored = [];
        heroSearchIndex.forEach(function (entry) {
          var value = score(entry, q, tokens);
          if (value > 0) scored.push({ entry: entry, value: value });
        });

        scored.sort(function (a, b) {
          if (b.value !== a.value) return b.value - a.value;
          return a.entry.name.localeCompare(b.entry.name);
        });

        return scored.map(function (row) {
          // Custom mode has no page of its own, so it routes back to the directory.
          var entry = row.entry;
          return {
            id: entry.id,
            slug: entry.slug,
            name: entry.name,
            meta: entry.meta,
            href: entry.id === CUSTOM_HERO_ID ? '/#calculators' : '/calculator/' + encodeURIComponent(entry.slug)
          };
        });
      }

      function rowLinks() {
        return Array.prototype.slice.call(dropdown.querySelectorAll('[data-hero-open]'));
      }

      /* No `refocus` argument: every one of the four call sites passed `false`, so
         the branch below was unreachable and the parameter was misleading. The
         input keeps focus on close in every real path, which is what a search
         field wants anyway. */
      function hide() {
        dropdown.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
      }

      /**
       * One row, one target. The whole title + description block is a single
       * anchor, and the "Load in Hero Calculator" action is a real sibling button.
       * The old markup put both inside a `role="option"` div with a delegated
       * `closest('[role="option"]') -> location.href` handler, so clicking the
       * description paragraph navigated the page from outside the link.
       */
      function rowMarkup(entry, index) {
        var href = escapeHtml(entry.href);
        return (
          '<li class="rounded-lg border border-transparent p-2.5 hover:bg-slate-50 focus-within:border-blue-300 focus-within:bg-blue-50">' +
          '<a id="hero-search-row-' + index + '" href="' + href + '" data-hero-open class="block rounded-md">' +
          '<span class="block text-sm font-semibold text-slate-900">' + escapeHtml(entry.name) + '</span>' +
          '<span class="mt-0.5 block text-xs text-slate-600">' + escapeHtml(entry.meta) + '</span>' +
          '</a>' +
          '<span class="mt-2 flex flex-wrap gap-2">' +
          '<a href="' + href + '" class="btn-accent focus-ring min-h-9 px-3 py-1.5 text-xs">Open full page</a>' +
          '<button type="button" data-hero-load="' + escapeHtml(entry.id) +
          '" class="btn-ghost-soft focus-ring min-h-9 px-3 py-1.5 text-xs">Load in Hero Calculator</button>' +
          '</span>' +
          '</li>'
        );
      }

      function render(query) {
        results = runSearch(query);

        if (!results.length) {
          dropdown.innerHTML =
            '<ul class="list-none"><li class="px-3 py-4 text-center text-[0.9375rem] text-slate-700">No calculators matched &ldquo;' +
            escapeHtml(query) +
            '&rdquo;. Try TNEA, KCET, NEET, B.Pharm or Tamil Nadu.</li></ul>';
          dropdown.classList.remove('hidden');
          input.setAttribute('aria-expanded', 'true');
          return;
        }

        var shown = results.slice(0, 6);
        dropdown.innerHTML =
          '<ul aria-label="Calculator search results" class="list-none">' +
          shown.map(rowMarkup).join('') +
          '</ul>';

        dropdown.classList.remove('hidden');
        input.setAttribute('aria-expanded', 'true');
      }

      /** Arrow keys move real focus between the result links; no ARIA state. */
      function moveFocus(step) {
        var links = rowLinks();
        if (!links.length) return false;
        var from = links.indexOf(document.activeElement);
        var next = from < 0 ? (step > 0 ? 0 : links.length - 1) : (from + step + links.length) % links.length;
        var target = links[next];
        if (!target || typeof target.focus !== 'function') return false;
        target.focus();
        if (typeof target.scrollIntoView === 'function') {
          target.scrollIntoView({ block: 'nearest' });
        }
        return true;
      }

      function handleRowKeys(event) {
        var step = 0;
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight') step = 1;
        else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') step = -1;
        else if (event.key === 'Home' || event.key === 'End') {
          var links = rowLinks();
          if (links.length) {
            event.preventDefault();
            (event.key === 'Home' ? links[0] : links[links.length - 1]).focus();
          }
          return;
        } else {
          return;
        }
        if (moveFocus(step)) event.preventDefault();
      }

      /** Push a fresh filter pass downstream; the input may have been rewritten. */
      function refilter() {
        try {
          window.dispatchEvent(new Event(REFILTER_EVENT));
        } catch {
          /* The filter initialiser may not be on this page. */
        }
      }

      function loadIntoHero(id) {
        if (!id) return;
        hide();
        input.value = '';
        refilter();
        window.dispatchEvent(new CustomEvent('allcutoff:load-calculator', { detail: { id: id } }));
      }

      dropdown.addEventListener('click', function (event) {
        var loadBtn = event.target.closest('[data-hero-load]');
        if (!loadBtn) return;
        event.preventDefault();
        loadIntoHero(loadBtn.getAttribute('data-hero-load'));
      });

      dropdown.addEventListener('keydown', handleRowKeys);

      input.addEventListener('input', function (event) {
        var value = event.target.value;
        if (!value.trim()) {
          hide();
          return;
        }
        render(value);
      });

      input.addEventListener('focus', function (event) {
        if (event.target.value.trim()) render(event.target.value);
      });

      input.addEventListener('keydown', function (event) {
        if (event.key === 'ArrowDown') {
          if (moveFocus(1)) event.preventDefault();
        } else if (event.key === 'ArrowUp') {
          if (moveFocus(-1)) event.preventDefault();
        } else if (event.key === 'Escape') {
          // Cancel the search outright: the box is emptied, so the directory
          // filter must be re-run or the grid stays narrowed with no visible
          // reason for it.
          hide();
          input.value = '';
          refilter();
        } else if (event.key === 'Enter') {
          // Enter in the field opens the top hit, matching the Ctrl+K dialog.
          var top = rowLinks()[0];
          if (top) {
            event.preventDefault();
            window.location.href = top.getAttribute('href');
          }
        }
      });

      document.addEventListener('click', function (event) {
        if (!dropdown.contains(event.target) && !input.contains(event.target)) hide();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroSearch);
    } else {
      initHeroSearch();
    }
  })();
</script>

<!-- ══════════════════════ FULL DIRECTORY SEARCH OPENER ══════════════════════ -->
<!--
  The magnifier button in the hero row is a real control, so it needs real
  behaviour rather than a decorative `onclick`. It delegates to `#search-btn`,
  the header's own trigger: SearchModal already binds its open/close logic,
  focus trap and scroll lock to that one element, and clicking it reuses all of
  it — including `lastFocused`, so dismissing the dialog returns focus to this
  button rather than to nothing.

  Re-implementing the shortcut here with a synthetic Ctrl+K would have been the
  shorter option and the worse one: a dispatched KeyboardEvent is not
  `isTrusted`, so any future guard in SearchModal against synthetic input would
  have silently broken this button first.

  Both paths are guarded. If the header trigger is ever removed the fallback
  focuses the hero field, which is still a useful action rather than a dead
  button, and the `input` may not exist either.
-->
<script>
  (function () {
    'use strict';

    function initDirectoryOpener() {
      var opener = document.getElementById('hero-search-open-directory');
      if (!opener) return;

      opener.addEventListener('click', function () {
        var headerTrigger = document.getElementById('search-btn');

        if (headerTrigger) {
          headerTrigger.click();
          return;
        }

        var heroInput = document.getElementById('hero-search-input');
        if (heroInput) heroInput.focus();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDirectoryOpener);
    } else {
      initDirectoryOpener();
    }
  })();
</script>

<!-- ══════════════════════ TABLE-OF-CONTENTS SCROLL SPY ══════════════════════ -->
<!--
  Marks the table-of-contents entry for whichever section is currently under the
  header. The active state is written as `aria-current="true"` — the same
  attribute a screen reader would announce on a manually highlighted link — and
  all of the styling hangs off that attribute, so there is no second "active"
  class that could disagree with what assistive tech is told.

  The observer band is the top ~55% of the viewport with the top offset for the
  sticky header, rather than a plain 50% line: the element a reader considers
  "current" is the one sitting under their eyes near the header, and a 50%
  viewport line flips the highlight halfway through a tall section.

  Nothing is ever un-highlighted to empty. Section boundaries are borders, so a
  momentary gap between two sections reports zero intersections; clearing the
  highlight there would make the entry list flicker while scrolling past a
  divider. The previous match simply stays put.
-->
<script>
  (function () {
    'use strict';

    function initTocScrollSpy() {
      var links = Array.prototype.slice.call(document.querySelectorAll('[data-toc-link]'));
      if (!links.length) return;

      var targets = links
        .map(function (link) {
          return { link: link, section: document.getElementById(link.getAttribute('data-toc-link')) };
        })
        .filter(function (row) {
          return !!row.section;
        });

      if (!targets.length || !('IntersectionObserver' in window)) return;

      function setActive(id) {
        targets.forEach(function (row) {
          var link = row.link;
          if (link.getAttribute('data-toc-link') === id) {
            link.setAttribute('aria-current', 'true');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      }

      var visible = [];

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            var index = visible.indexOf(entry.target);
            if (entry.isIntersecting && index === -1) visible.push(entry.target);
            if (!entry.isIntersecting && index !== -1) visible.splice(index, 1);
          });

          // `targets` is already in document order, so the first visible match
          // is the topmost section on screen, not the last one to fire.
          var active = null;
          for (var i = 0; i < targets.length; i += 1) {
            if (visible.indexOf(targets[i].section) !== -1) {
              active = targets[i].link.getAttribute('data-toc-link');
              break;
            }
          }

          if (active) setActive(active);
        },
        { rootMargin: '-88px 0px -55% 0px', threshold: 0 }
      );

      targets.forEach(function (row) {
        observer.observe(row.section);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTocScrollSpy);
    } else {
      initTocScrollSpy();
    }
  })();
</script>

<!-- ══════════════════════ SCROLL REVEAL ══════════════════════ -->
<!--
  `.reveal` elements are hidden by `html.js-reveal` in global.css, and that
  class is set by the inline script at the very top of the body — early
  precisely so nothing is painted hidden and then snapped back. This block only
  has to decide when each element becomes visible.

  Everything on screen at init is revealed synchronously, before the observer is
  even created. Waiting for the observer's first callback instead left the
  contents section, the state strip and the top of `#what-is` invisible for the
  frames between this script running and that callback landing — a visible flash
  on exactly the content a returning reader lands on first.

  `prefers-reduced-motion: reduce` and browsers without IntersectionObserver both
  short-circuit to "everything visible": in both cases the reader asked for, or
  the engine can only provide, a page with no reveal at all, and a half-revealed
  page is worse than either.
-->
<script>
  (function () {
    'use strict';

    function initScrollReveal() {
      var targets = Array.prototype.slice.call(document.querySelectorAll('.reveal'));
      if (!targets.length) return;

      function show(el) {
        el.classList.add('is-visible');
      }

      var reduceMotion =
        typeof window.matchMedia === 'function' &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion || !('IntersectionObserver' in window)) {
        targets.forEach(show);
        return;
      }

      var viewportHeight = window.innerHeight || 0;
      var pending = targets.filter(function (el) {
        var rect = el.getBoundingClientRect();
        return rect.top < viewportHeight && rect.bottom > 0;
      });

      pending.forEach(show);

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            show(entry.target);
            // One-shot: once a section has arrived it stays, so scrolling back up
            // never replays the animation over content the reader has already read.
            observer.unobserve(entry.target);
          });
        },
        {
          // Fires as the element settles into the viewport rather than at the
          // instant its top edge grazes it — the -10% bottom margin is what keeps
          // the reveal from firing for a block still mostly below the fold.
          rootMargin: '0px 0px -10% 0px',
          threshold: 0.08
        }
      );

      targets.forEach(function (el) {
        // Anything already revealed above is skipped: it needs no observation,
        // and re-adding it to the observer would be a wasted entry.
        if (el.classList.contains('is-visible')) return;
        observer.observe(el);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initScrollReveal);
    } else {
      initScrollReveal();
    }
  })();
</script>