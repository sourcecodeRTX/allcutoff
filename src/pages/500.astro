---
import Layout, { SITE_URL } from '../layouts/Layout.astro';
import { CALCULATORS } from '../data/calculators';

const siteUrl = SITE_URL;
const canonical = `${siteUrl}/500`;

const title = "500: Server Error";
const description = "An unexpected error occurred on All Cut Off. Please refresh the page or return to our homepage to access our verified Indian admission cutoff calculators.";

// Pick top popular calculators for quick recovery
const popularCalculators = CALCULATORS.slice(0, 4);
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonical}
  noindex={true}
>
  <!-- Hero Section -->
  <section class="border-b border-slate-200 bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <nav aria-label="Breadcrumb" class="flex justify-center">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-600">
          <li><a href="/" class="transition-colors hover:text-blue-600">Home</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-medium text-slate-900">500 Server Error</li>
        </ol>
      </nav>

      <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-rose-200 bg-rose-50 px-3 py-1 font-mono text-xs font-semibold uppercase tracking-wider text-rose-700">
        <span class="inline-block h-2 w-2 rounded-full bg-rose-500"></span>
        HTTP Status 500
      </div>

      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Internal Server Error
      </h1>

      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-slate-600 sm:text-lg">
        An unexpected error occurred while processing this request. Don't worry—our cutoff calculators run 100% client-side in your browser, so your entered marks are never lost.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <button
          type="button"
          id="reload-page-btn"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Reload Page
        </button>

        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
        >
          <svg class="h-4 w-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Return to Homepage
        </a>
      </div>
    </div>
  </section>

  <!-- Troubleshooting & Direct Access -->
  <section class="py-12 sm:py-16" aria-labelledby="troubleshooting-heading">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <div class="hairline-card rounded-xl p-6 bg-white">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-600 font-bold">
            1
          </div>
          <h2 id="troubleshooting-heading" class="mt-4 text-base font-bold text-slate-900">
            Refresh the Page
          </h2>
          <p class="mt-2 text-xs leading-relaxed text-slate-600">
            A temporary network interruption or proxy timeout may have occurred. Refreshing the browser often resolves the issue instantly.
          </p>
        </div>

        <div class="hairline-card rounded-xl p-6 bg-white">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-600 font-bold">
            2
          </div>
          <h2 class="mt-4 text-base font-bold text-slate-900">
            Client-Side Computing
          </h2>
          <p class="mt-2 text-xs leading-relaxed text-slate-600">
            All All Cut Off calculators compute results strictly in your local browser without transmitting private score records to external servers.
          </p>
        </div>

        <div class="hairline-card rounded-xl p-6 bg-white">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-600 font-bold">
            3
          </div>
          <h2 class="mt-4 text-base font-bold text-slate-900">
            Contact Support
          </h2>
          <p class="mt-2 text-xs leading-relaxed text-slate-600">
            If this error persists, please let us know through our contact channel so we can investigate and resolve it immediately.
          </p>
          <a href="/contact" class="mt-3 inline-block text-xs font-semibold text-blue-600 hover:underline">
            Report an Issue &rarr;
          </a>
        </div>
      </div>

      <!-- Quick Access Calculators -->
      <div class="mt-10 hairline-card rounded-2xl bg-white p-6 sm:p-8">
        <h2 class="text-base font-bold text-slate-900 sm:text-lg">
          Or Continue with Direct Cutoff Tools
        </h2>
        <p class="mt-1 text-sm text-slate-600">
          Jump directly to any of our most frequently accessed admission calculators:
        </p>

        <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {popularCalculators.map((calc) => (
            <a
              href={`/calculator/${calc.slug}`}
              class="flex items-center justify-between rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-800 transition hover:border-blue-300 hover:bg-blue-50/50 hover:text-blue-600"
            >
              <span>{calc.name}</span>
              <span class="font-mono text-xs text-slate-500">/{calc.slug}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var reloadBtn = document.getElementById('reload-page-btn');
      if (reloadBtn) {
        reloadBtn.addEventListener('click', function () {
          window.location.reload();
        });
      }
    })();
  </script>
</Layout>
