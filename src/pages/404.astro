---
import Layout, { SITE_URL } from '../layouts/Layout.astro';
import { CALCULATORS } from '../data/calculators';

const siteUrl = SITE_URL;
const canonical = `${siteUrl}/404`;

const title = "404: Page Not Found";
const description = "The page or cutoff calculator you were looking for could not be found on All Cut Off. Search our verified college admission calculators or browse popular tools.";

// Pick top popular calculators for quick navigation
const popularCalculators = CALCULATORS.slice(0, 6);
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonical}
  noindex={true}
>
  <!-- Hero Section -->
  <section class="border-b border-slate-200 bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <nav aria-label="Breadcrumb" class="flex justify-center">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-600">
          <li><a href="/" class="transition-colors hover:text-blue-600">Home</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-medium text-slate-900">404 Not Found</li>
        </ol>
      </nav>

      <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3 py-1 font-mono text-xs font-semibold uppercase tracking-wider text-amber-700">
        <span class="inline-block h-2 w-2 rounded-full bg-amber-500"></span>
        HTTP Status 404
      </div>

      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl md:text-5xl">
        Page Not Found
      </h1>

      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-slate-600 sm:text-lg">
        The admission calculator or page you requested could not be located. It might have been relocated, renamed, or typed incorrectly.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Back to Homepage
        </a>

        <button
          type="button"
          id="trigger-search-from-404"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
        >
          <svg class="h-4 w-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Search Calculators
        </button>
      </div>
    </div>
  </section>

  <!-- Popular Calculators Directory -->
  <section class="py-12 sm:py-16" aria-labelledby="popular-heading">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="text-center sm:text-left">
        <span class="font-mono text-xs uppercase tracking-widest text-blue-600">DIRECT SHORTCUTS</span>
        <h2 id="popular-heading" class="mt-1 text-xl font-bold text-slate-900 sm:text-2xl">
          Popular Admission Cutoff Calculators
        </h2>
        <p class="mt-2 text-sm text-slate-600">
          Looking for a specific admission counseling cutoff? Choose from our official calculators below:
        </p>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {popularCalculators.map((calc) => (
          <a
            href={`/calculator/${calc.slug}`}
            class="hairline-card group flex flex-col justify-between rounded-xl p-5 transition hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-md"
          >
            <div>
              <div class="flex items-center justify-between text-xs text-slate-500">
                <span class="font-medium text-blue-600">{calc.category}</span>
                <span>{calc.state}</span>
              </div>
              <h3 class="mt-2 text-base font-semibold text-slate-900 group-hover:text-blue-600">
                {calc.name}
              </h3>
              <p class="mt-1.5 text-xs text-slate-600 line-clamp-2">
                {calc.summary}
              </p>
            </div>
            <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3 text-xs text-slate-500">
              <span class="font-mono">Max: {calc.maxScore}</span>
              <span class="font-medium text-blue-600 group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1">
                Calculate &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Additional Assistance Block -->
      <div class="mt-10 hairline-card rounded-2xl bg-white p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <h3 class="text-base font-bold text-slate-900">Still Can't Find What You Need?</h3>
            <p class="mt-1 text-sm text-slate-600">
              Check our complete list of calculators on the home page or contact our team with feedback.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <a
              href="/#calculators"
              class="inline-flex items-center text-sm font-semibold text-blue-600 hover:text-blue-700 hover:underline underline-offset-2"
            >
              Browse All Calculators &rarr;
            </a>
            <span class="text-slate-300" aria-hidden="true">&bull;</span>
            <a
              href="/contact"
              class="inline-flex items-center text-sm font-semibold text-slate-700 hover:text-slate-900 hover:underline underline-offset-2"
            >
              Contact Support
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var btn = document.getElementById('trigger-search-from-404');
      if (btn) {
        btn.addEventListener('click', function () {
          var mainSearchBtn = document.getElementById('search-btn');
          if (mainSearchBtn) {
            mainSearchBtn.click();
          }
        });
      }
    })();
  </script>
</Layout>
